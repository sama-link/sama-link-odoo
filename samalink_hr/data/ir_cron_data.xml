<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weekly absence entry generation (every Friday). Priority 0 = runs before adjust cron when both are due. -->
    <record id="ir_cron_generate_absent_entries" model="ir.cron">
        <field name="name">Generate Absence Entries (Weekly - Friday)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_absent_entries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="priority" eval="0"/>
        <field name="active">True</field>
    </record>

    <!-- Weekly work entry adjustment: lower priority (10) so it always runs after absence cron in the same scheduler tick. -->
    <record id="ir_cron_adjust_work_entries_flexible" model="ir.cron">
        <field name="name">Adjust Work Entries - Flexible Rest Days (Weekly - Friday)</field>
        <field name="model_id" ref="hr_work_entry.model_hr_work_entry"/>
        <field name="state">code</field>
        <field name="code">model.cron_adjust_flexible_rest_days()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="priority" eval="10"/>
        <field name="active">True</field>
    </record>
</odoo>
