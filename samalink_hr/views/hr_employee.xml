<odoo>
    <data>
        <record id="view_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <field name="mobile_phone" position="after">
                    <field name="work_location_id"/>
                    <field name="medical_insurance"/>
                </field>
                <group name="identification_group" position="inside">
                    <field name="allow_check_from_odoo"/>
                </group>
                <header position="inside">
                    <button name="action_add_data_from_job_position" string="Add Data From Job Position" type="object"/>
                </header>
                <div name="button_box" position="inside">
                    <button type="object" class="oe_stat_button" id="action_view_absent_entries" icon="fa-calendar-times-o" name="action_view_absent_entries">
                        <div class="o_stat_info">
                            <span class="o_stat_text">
                            Absent Entries
                            </span>
                        </div>
                    </button>
                </div>
            </field>
        </record>

        <!-- Guard the eLearning stat-button block against non-officers.
             On DBs where the stored hr_skills_slides arch predates the upstream
             group gate, the field reaches users who don't get it in fields_get
             and the employee form crashes (OwlError: has_subscribed_courses is
             undefined). Forcing the groups here strips both nodes together. -->
        <record id="view_employee_form_slides_gate" model="ir.ui.view">
            <field name="name">hr.employee.form.slides.courses.gate</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_skills_slides.hr_employee_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='has_subscribed_courses']" position="attributes">
                    <attribute name="groups">website_slides.group_website_slides_officer</attribute>
                </xpath>
                <xpath expr="//button[@name='action_open_courses']" position="attributes">
                    <attribute name="groups">website_slides.group_website_slides_officer</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_employee_tree" model="ir.ui.view">
            <field name="name">hr.employee.tree.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <list position="inside">
                    <field name="work_location_id" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_employee_filter" model="ir.ui.view">
            <field name="name">hr.employee.filter.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <search position="inside">
                    <field name="work_location_id" string="Work Location" />
                    <filter name="group_work_location" string="Work Location" domain="[]" context="{'group_by': 'work_location_id'}"/>
                </search>
            </field>
        </record>
    </data>
</odoo>