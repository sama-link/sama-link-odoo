<odoo>
    <record id="view_resource_calendar_form_inherit_flexible" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.flexible</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="after">
                <field name="flexible_rest_day"/>
                <field name="rest_days_per_week"
                       invisible="not flexible_rest_day"/>
            </xpath>
        </field>
    </record>
</odoo>
