<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_samalink_hr_friday_swap" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.samalink.hr.friday.swap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Samalink HR" name="samalink_hr" groups="base.group_system">
                    <block title="Friday Swap Settings (Deprecated)" id="samalink_hr_friday_swap_settings">
                        <setting
                            id="samalink_hr_friday_swap_excluded_schedules"
                            string="Excluded Working Schedules (Deprecated)"
                            help="DEPRECATED: Use the 'Flexible Rest Days' checkbox on each Work Schedule instead. This setting will be removed in a future version."
                        >
                            <field name="friday_swap_excluded_schedule_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
