<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sl_qbonus_task_form" model="ir.ui.view">
            <field name="name">sl.qbonus.task.form</field>
            <field name="model">sl.qbonus.task</field>
            <field name="arch" type="xml">
                <form string="Task">
                    <header>
                        <field name="stage" widget="statusbar" statusbar_visible="todo,doing,done"
                               options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Data migration"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id" options="{'no_create': True}"/>
                                <field name="project_state" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="assignee_id" options="{'no_create': True}"
                                       domain="[('id', 'in', project_member_ids)]"/>
                                <field name="project_member_ids" invisible="1"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_deadline"/>
                                <field name="priority" widget="priority"/>
                                <field name="is_overdue" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sl_qbonus_task_list" model="ir.ui.view">
            <field name="name">sl.qbonus.task.list</field>
            <field name="model">sl.qbonus.task</field>
            <field name="arch" type="xml">
                <list string="Tasks" decoration-success="stage == 'done'" decoration-muted="stage == 'cancelled'"
                      decoration-danger="is_overdue">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="assignee_id"/>
                    <field name="date_start" optional="hide"/>
                    <field name="date_deadline"/>
                    <field name="priority" widget="priority" optional="show"/>
                    <field name="is_overdue" column_invisible="True"/>
                    <field name="stage" widget="badge"
                           decoration-info="stage == 'doing'" decoration-success="stage == 'done'"/>
                </list>
            </field>
        </record>

        <record id="view_sl_qbonus_task_kanban" model="ir.ui.view">
            <field name="name">sl.qbonus.task.kanban</field>
            <field name="model">sl.qbonus.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage" quick_create="false" class="o_kanban_small_column">
                    <field name="color"/>
                    <field name="stage"/>
                    <field name="is_overdue"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="ps-2 #{record.is_overdue.raw_value ? 'border-start border-danger border-3' : ''}">
                                <div class="d-flex justify-content-between align-items-start">
                                    <field name="name" class="fw-bold"/>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="text-muted small"><field name="project_id"/></div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-muted small"><i class="fa fa-calendar-o me-1"/><field name="date_deadline"/></span>
                                    <field name="assignee_id" widget="many2one_avatar_employee"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_sl_qbonus_task_calendar" model="ir.ui.view">
            <field name="name">sl.qbonus.task.calendar</field>
            <field name="model">sl.qbonus.task</field>
            <field name="arch" type="xml">
                <calendar string="Tasks" date_start="date_deadline" color="project_id" mode="month"
                          quick_create="0" event_open_popup="1">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="assignee_id"/>
                    <field name="stage"/>
                </calendar>
            </field>
        </record>

        <record id="view_sl_qbonus_task_search" model="ir.ui.view">
            <field name="name">sl.qbonus.task.search</field>
            <field name="model">sl.qbonus.task</field>
            <field name="arch" type="xml">
                <search string="Tasks">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="assignee_id"/>
                    <filter name="my_tasks" string="My Tasks" domain="[('assignee_user_id', '=', uid)]"/>
                    <filter name="my_projects" string="My Projects' Tasks" domain="[('owner_user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="open" string="Open" domain="[('stage', 'not in', ('done', 'cancelled'))]"/>
                    <filter name="overdue" string="Overdue"
                            domain="[('stage', 'not in', ('done', 'cancelled')), ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                        <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                        <filter name="group_assignee" string="Assignee" context="{'group_by': 'assignee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sl_qbonus_task" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">sl.qbonus.task</field>
            <field name="view_mode">kanban,list,calendar,form</field>
            <field name="search_view_id" ref="view_sl_qbonus_task_search"/>
            <field name="context">{'search_default_open': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No tasks yet</p>
                <p>Project owners create tasks inside their projects and assign them to team members.</p>
            </field>
        </record>

    </data>
</odoo>
