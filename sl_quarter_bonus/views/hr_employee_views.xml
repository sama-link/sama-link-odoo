<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_qbonus" model="ir.ui.view">
            <field name="name">hr.employee.form.qbonus</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_qbonus_projects" type="object" class="oe_stat_button" icon="fa-trophy"
                            groups="sl_quarter_bonus.group_qbonus_admin">
                        <field name="qbonus_project_count" widget="statinfo" string="Bonus Projects"/>
                    </button>
                </div>
                <notebook position="inside">
                    <page string="Quarterly Bonus" name="qbonus" groups="sl_quarter_bonus.group_qbonus_admin">
                        <group>
                            <field name="bonus_quarterly_exclusion" string="Quarterly project bonus track"/>
                            <div colspan="2" class="text-muted">
                                When checked, this employee is paid through the quarterly project bonus and is
                                skipped by the monthly bonus calculator (reason: "Quarterly bonus track").
                            </div>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
