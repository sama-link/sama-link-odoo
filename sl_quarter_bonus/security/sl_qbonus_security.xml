<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════════ Multi-company (global, AND-ed with the group rules) ════════════ -->
        <record id="rule_qbonus_project_company" model="ir.rule">
            <field name="name">Quarterly bonus project: company</field>
            <field name="model_id" ref="model_sl_qbonus_project"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_qbonus_task_company" model="ir.rule">
            <field name="name">Quarterly bonus task: company</field>
            <field name="model_id" ref="model_sl_qbonus_task"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_qbonus_member_company" model="ir.rule">
            <field name="name">Quarterly bonus project member: company</field>
            <field name="model_id" ref="model_sl_qbonus_project_member"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_qbonus_quarter_company" model="ir.rule">
            <field name="name">Quarterly bonus quarter: company</field>
            <field name="model_id" ref="model_sl_qbonus_quarter"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_qbonus_line_company" model="ir.rule">
            <field name="name">Quarterly bonus line: company</field>
            <field name="model_id" ref="model_sl_qbonus_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ════════════ Projects ════════════
             Rules of different groups are OR-ed, and admin implies owner
             implies employee, so an owner also sees projects they are merely
             a member of, and the admin sees everything. The stored user
             fields keep the domains off hr.employee (whose reads are
             team-limited on this database). -->
        <record id="rule_qbonus_project_employee" model="ir.rule">
            <field name="name">Quarterly bonus project: employee sees projects they are on</field>
            <field name="model_id" ref="model_sl_qbonus_project"/>
            <field name="domain_force">[('member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_employee'))]"/>
        </record>
        <record id="rule_qbonus_project_owner" model="ir.rule">
            <field name="name">Quarterly bonus project: owner manages own projects</field>
            <field name="model_id" ref="model_sl_qbonus_project"/>
            <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_owner'))]"/>
        </record>
        <record id="rule_qbonus_project_admin" model="ir.rule">
            <field name="name">Quarterly bonus project: admin sees all</field>
            <field name="model_id" ref="model_sl_qbonus_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_admin'))]"/>
        </record>

        <!-- ════════════ Tasks ════════════ -->
        <record id="rule_qbonus_task_employee" model="ir.rule">
            <field name="name">Quarterly bonus task: employee sees tasks of their projects</field>
            <field name="model_id" ref="model_sl_qbonus_task"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_employee'))]"/>
        </record>
        <record id="rule_qbonus_task_owner" model="ir.rule">
            <field name="name">Quarterly bonus task: owner manages tasks of own projects</field>
            <field name="model_id" ref="model_sl_qbonus_task"/>
            <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_owner'))]"/>
        </record>
        <record id="rule_qbonus_task_admin" model="ir.rule">
            <field name="name">Quarterly bonus task: admin sees all</field>
            <field name="model_id" ref="model_sl_qbonus_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_admin'))]"/>
        </record>

        <!-- ════════════ Team & points lines ════════════
             Employees see only their own row: colleagues' points on the same
             project are the owner's business. -->
        <record id="rule_qbonus_member_employee" model="ir.rule">
            <field name="name">Quarterly bonus member line: employee sees own row</field>
            <field name="model_id" ref="model_sl_qbonus_project_member"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_employee'))]"/>
        </record>
        <record id="rule_qbonus_member_owner" model="ir.rule">
            <field name="name">Quarterly bonus member line: owner manages own projects' rows</field>
            <field name="model_id" ref="model_sl_qbonus_project_member"/>
            <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_owner'))]"/>
        </record>
        <record id="rule_qbonus_member_admin" model="ir.rule">
            <field name="name">Quarterly bonus member line: admin sees all</field>
            <field name="model_id" ref="model_sl_qbonus_project_member"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_admin'))]"/>
        </record>

        <!-- ════════════ Employee bonus lines ════════════ -->
        <record id="rule_qbonus_line_employee" model="ir.rule">
            <field name="name">Quarterly bonus line: employee sees own lines of closed quarters</field>
            <field name="model_id" ref="model_sl_qbonus_line"/>
            <field name="domain_force">[('user_id', '=', user.id), ('quarter_state', '=', 'closed')]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_employee'))]"/>
        </record>
        <record id="rule_qbonus_line_admin" model="ir.rule">
            <field name="name">Quarterly bonus line: admin sees all</field>
            <field name="model_id" ref="model_sl_qbonus_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_qbonus_admin'))]"/>
        </record>
    </data>
</odoo>
