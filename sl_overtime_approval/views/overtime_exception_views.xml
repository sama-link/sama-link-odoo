<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_overtime_approval_exception_list" model="ir.ui.view">
        <field name="name">sl.overtime.approval.exception.list</field>
        <field name="model">sl.overtime.approval.exception</field>
        <field name="arch" type="xml">
            <list string="Overtime Approval Exceptions" editable="bottom">
                <field name="employee_id"/>
                <field name="company_id" optional="hide"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_overtime_approval_exception_search" model="ir.ui.view">
        <field name="name">sl.overtime.approval.exception.search</field>
        <field name="model">sl.overtime.approval.exception</field>
        <field name="arch" type="xml">
            <search string="Overtime Approval Exceptions">
                <field name="employee_id"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_overtime_approval_exception" model="ir.actions.act_window">
        <field name="name">Overtime Approval Exceptions</field>
        <field name="res_model">sl.overtime.approval.exception</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add employees whose overtime is approved directly
            </p>
            <p>
                Overtime for employees on this list is approved with one click,
                without asking the approver for a reason.
            </p>
        </field>
    </record>

    <menuitem id="menu_overtime_approval_exception"
              name="Overtime Approval Exceptions"
              parent="hr_attendance.menu_hr_attendance_settings"
              action="action_overtime_approval_exception"
              sequence="20"
              groups="samalink_security_groups.group_samalink_administrator,samalink_security_groups.group_samalink_hr_officer"/>

</odoo>
