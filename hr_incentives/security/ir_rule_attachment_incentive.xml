<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- OR with restrictive ir.attachment rules so incentive files are not limited to create_uid -->
        <record id="ir_attachment_rule_incentives_officer" model="ir.rule">
            <field name="name">Attachments: Incentives Officer — incentive files</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[('res_model', '=', 'hr.incentive')]</field>
            <field name="groups" eval="[(4, ref('hr_incentives.group_hr_incentives_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="ir_attachment_rule_incentives_manager" model="ir.rule">
            <field name="name">Attachments: Incentives Manager — incentive files</field>
