<odoo>
    <template id="report_hr_incentive_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout" t-lang="'ar_001'">
                    <div class="page" style="font-family: Arial, sans-serif; direction: rtl; text-align: right;">

                        <!-- Title -->
                        <div class="text-center" style="margin-bottom: 20px;">
                            <h2 style="font-weight: bold; text-transform: uppercase; border-bottom: 2px solid #333; display: inline-block; padding-bottom: 5px;">
                                <t t-if="doc.type == 'bonus'">مستند حافز</t>
                                <t t-if="doc.type == 'penalty'">مستند خصم</t>
                            </h2>
                        </div>

                        <!-- Status Badge -->
                        <div class="text-center" style="margin-bottom: 25px;">
                            <span t-attf-style="padding: 4px 16px; border-radius: 4px; font-weight: bold; color: #fff; background-color: {{ 'green' if doc.state == 'approved' else 'orange' if doc.state == 'validated' else 'gray' if doc.state == 'draft' else 'red' }};"
                                  t-field="doc.state"/>
                        </div>

                        <!-- Employee & Company Info -->
                        <div class="row" style="margin-bottom: 25px;">
                            <div class="col-6">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="padding: 4px 8px; font-weight: bold; width: 40%;">الموظف</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.employee_id"/></td>
                                    </tr>
                                    <tr t-if="doc.employee_id.job_id">
                                        <td style="padding: 4px 8px; font-weight: bold;">المنصب الوظيفي</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.employee_id.job_id"/></td>
                                    </tr>
                                    <tr t-if="doc.employee_id.department_id">
                                        <td style="padding: 4px 8px; font-weight: bold;">القسم</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.employee_id.department_id"/></td>
                                    </tr>
                                    <tr t-if="doc.work_location_id">
                                        <td style="padding: 4px 8px; font-weight: bold;">موقع العمل</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.work_location_id"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="padding: 4px 8px; font-weight: bold; width: 40%;">الشركة</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.company_id"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px; font-weight: bold;">التاريخ</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.date"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px; font-weight: bold;">العقد</td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.current_contract_id"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Incentive Details Table -->
                        <table class="table table-bordered" style="margin-bottom: 25px;">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th style="padding: 8px; text-align: center;">نوع الحافز</th>
                                    <th style="padding: 8px; text-align: center;">طريقة الصرف</th>
                                    <th style="padding: 8px; text-align: center;">بناءً على</th>
                                    <th t-if="doc.based_on == 'days'" style="padding: 8px; text-align: center;">عدد الأيام</th>
                                    <th style="padding: 8px; text-align: center;">المبلغ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 8px; text-align: center;">
                                        <t t-if="doc.type == 'bonus'">حافز</t>
                                        <t t-if="doc.type == 'penalty'">خصم</t>
                                    </td>
                                    <td style="padding: 8px; text-align: center;">
                                        <t t-if="doc.payment_type == 'with_salary'">مع الراتب</t>
                                        <t t-if="doc.payment_type == 'immediate'">فوري</t>
                                    </td>
                                    <td style="padding: 8px; text-align: center;">
                                        <t t-if="doc.based_on == 'days'">أيام</t>
                                        <t t-if="doc.based_on == 'amount'">مبلغ</t>
                                    </td>
                                    <td t-if="doc.based_on == 'days'" style="padding: 8px; text-align: center;">
                                        <span t-field="doc.days"/>
                                    </td>
                                    <td style="padding: 8px; text-align: center; font-weight: bold;">
                                        <span t-field="doc.amount" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Description -->
                        <div t-if="doc.description" style="margin-bottom: 30px;">
                            <h5 style="font-weight: bold; border-bottom: 1px solid #ddd; padding-bottom: 5px;">الوصف</h5>
                            <p style="padding: 8px; background-color: #fafafa; border-radius: 4px;">
                                <span t-field="doc.description"/>
                            </p>
                        </div>

                        <!-- Signature Area -->
                        <div class="row" style="margin-top: 60px;">
                            <div class="col-4 text-center">
                                <div style="border-top: 1px solid #333; padding-top: 5px; margin: 0 20px;">
                                    توقيع الموظف
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top: 1px solid #333; padding-top: 5px; margin: 0 20px;">
                                    توقيع المدير
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top: 1px solid #333; padding-top: 5px; margin: 0 20px;">
                                    توقيع الموارد البشرية
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
