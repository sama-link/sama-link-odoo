<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_batch_employees_form" model="ir.ui.view">
        <field name="name">hr.appraisal.batch.employees.form</field>
        <field name="model">hr.appraisal.batch.employees</field>
        <field name="arch" type="xml">
            <form string="Generate Appraisals">
                <field name="batch_id" invisible="1"/>
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="department_id"/>
                        <field name="job_id"/>
                    </group>
                    <group>
                        <field name="work_location_id"/>
                        <field name="manager_id"/>
                        <field name="employee_search" placeholder="Search employees"/>
                    </group>
                </group>

                <div class="d-flex gap-2 mb-2">
                    <button name="action_select_all_filtered"
                            string="Select All Filtered"
                            type="object"
                            class="btn-secondary"/>
                </div>

                <field name="employee_ids" widget="many2many">
                    <list>
                        <field name="name"/>
                        <field name="job_id"/>
                        <field name="department_id"/>
                        <field name="work_location_id"/>
                        <field name="parent_id" string="General Manager"/>
                    </list>
                </field>

                <footer>
                    <button name="action_generate_appraisals"
                            string="Generate Appraisals"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
