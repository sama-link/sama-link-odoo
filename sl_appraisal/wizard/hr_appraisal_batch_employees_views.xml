<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_batch_employees_form" model="ir.ui.view">
        <field name="name">hr.appraisal.batch.employees.form</field>
        <field name="model">hr.appraisal.batch.employees</field>
        <field name="arch" type="xml">
            <form string="Generate Appraisals">
                <field name="batch_id" invisible="1"/>
                <field name="issue_employee_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="department_id"/>
                        <field name="job_id"/>
                    </group>
                    <group>
                        <field name="work_location_id"/>
                        <field name="manager_id"/>
                        <field name="employee_search" placeholder="Search employees"/>
                    </group>
                </group>

                <div class="alert alert-warning d-flex align-items-center justify-content-between mb-2"
                     role="alert" invisible="not issue_count">
                    <span>
                        ⚠ <field name="issue_count" readonly="1" class="oe_inline fw-bold"/>
                        employee(s) changed job or have a contract starting/ending in this period.
                        They are not listed below — review them one by one.
                    </span>
                    <button name="action_open_review_wizard"
                            string="Review employees with issues"
                            type="object"
                            class="btn-warning ms-2"/>
                </div>

                <div class="d-flex gap-2 mb-2">
                    <button name="action_select_all_filtered"
                            string="Select All Filtered"
                            type="object"
                            class="btn-secondary"/>
                </div>

                <field name="employee_ids" widget="many2many"
                       domain="[('appraisal_eligible', '=', True), ('id', 'not in', issue_employee_ids)]">
                    <list>
                        <field name="name"/>
                        <field name="job_id"/>
                        <field name="department_id"/>
                        <field name="work_location_id"/>
                        <field name="parent_id" string="General Manager"/>
                    </list>
                </field>

                <footer>
                    <button name="action_generate_appraisals"
                            string="Generate Appraisals"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
