<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_batch_contract_warning_form" model="ir.ui.view">
        <field name="name">hr.appraisal.batch.contract.warning.form</field>
        <field name="model">hr.appraisal.batch.contract.warning</field>
        <field name="arch" type="xml">
            <form string="Employees Without Active Contract">
                <field name="batch_id" invisible="1"/>
                <field name="ok_employee_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    ⚠ The employees below have <b>no active contract</b> covering the batch period
                    (<field name="date_from" readonly="1" class="oe_inline"/> →
                    <field name="date_to" readonly="1" class="oe_inline"/>).
                    Choose for each one whether to still add them to the appraisal batch.
                    All other selected employees will be added normally.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="employee_id" force_save="1" readonly="1"/>
                        <field name="job_id"/>
                        <field name="department_id"/>
                        <field name="decision" widget="radio" options="{'horizontal': true}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
