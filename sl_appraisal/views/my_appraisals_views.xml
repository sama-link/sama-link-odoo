<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         MY APPRAISALS — Employee self-service standalone views
         ============================================================ -->

    <!-- List View -->
    <record id="sl_my_appraisals_view_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.my.list</field>
        <field name="model">hr.appraisal</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-success="state == 'hr_finalization'"
                  decoration-warning="state == 'published'"
                  decoration-bf="state == 'draft'">
                <field name="appraisal_deadline" string="Appraisal Date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'hr_finalization'"
                       decoration-warning="state == 'published'"
                       decoration-info="state == 'draft'"/>
                <field name="skill_line_count" string="Skills Evaluated"/>
                <field name="final_interview" string="Final Interview"/>
            </list>
        </field>
    </record>

    <!-- Form View (read-only for employee) -->
    <record id="sl_my_appraisals_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.my.form</field>
        <field name="model">hr.appraisal</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="My Appraisal" create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,published,submitted,hr_finalization"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>My Appraisal — </span>
                            <field name="appraisal_deadline" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="appraisal_deadline" readonly="1"/>
                        </group>
                        <group>
                            <field name="final_interview" readonly="1"/>
                            <field name="creater_id" string="Conducted By" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Skills Results -->
                        <page string="🎯 Skills Evaluation Results" name="skill_results">
                            <div class="alert alert-info mb-3" role="alert"
                                 invisible="state != 'hr_finalization'">
                                <i class="fa fa-check-circle me-1"/>
                                <strong>Finalized:</strong>
                                These skill levels have been approved by HR and applied
                                to your employee profile.
                            </div>
                            <div class="alert alert-warning mb-3" role="alert"
                                 invisible="state == 'hr_finalization'">
                                <i class="fa fa-clock-o me-1"/>
                                <strong>In Progress:</strong>
                                This appraisal is still being reviewed.
                                Skill feedback details are hidden until HR
                                finalizes the appraisal.
                            </div>
                            <field name="appraisal_skill_line_ids" nolabel="1" readonly="1"
                                   invisible="state != 'hr_finalization'">
                                <list create="false" edit="false" delete="false"
                                      decoration-success="level_change == 'improved'"
                                      decoration-danger="level_change == 'declined'"
                                      decoration-info="level_change == 'new'">
                                    <field name="skill_type_id" readonly="1"/>
                                    <field name="skill_id" readonly="1"/>
                                    <field name="current_skill_level_id"
                                           string="Before" readonly="1"/>
                                    <field name="current_level_progress"
                                           widget="progressbar" string="Before %" readonly="1"/>
                                    <field name="final_skill_level_id"
                                           string="After" readonly="1"
                                           invisible="state != 'hr_finalization'"/>
                                    <field name="final_level_progress"
                                           widget="progressbar" string="After %" readonly="1"
                                           invisible="state != 'hr_finalization'"/>
                                    <field name="level_change" string="Δ" readonly="1"
                                           invisible="state != 'hr_finalization'"/>
                                    <field name="state" column_invisible="True" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Same administration breakdown as HR appraisal form (read-only) -->
                        <page string="🧮 Administration Score" name="my_administration_score_tab">
                            <group string="Period">
                                <group>
                                    <field name="period_days" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Score Components"/>
                            <group col="2">
                                <group string="Absence">
                                    <field name="absence_count" readonly="1"/>
                                    <field name="absence_score" readonly="1"/>
                                </group>
                                <group string="Late Arrival">
                                    <field name="late_count" readonly="1"/>
                                    <field name="late_score" readonly="1"/>
                                </group>
                            </group>
                            <group col="2">
                                <group string="Early Leaving">
                                    <field name="early_leaving_count" readonly="1"/>
                                    <field name="early_leaving_score" readonly="1"/>
                                </group>
                                <group string="Penalties">
                                    <field name="penalty_count" readonly="1"/>
                                    <field name="penalty_score" readonly="1"/>
                                </group>
                            </group>
                            <group col="2">
                                <group string="Bonuses">
                                    <field name="bonus_count" readonly="1"/>
                                    <field name="bonus_score" readonly="1"/>
                                </group>
                                <group/>
                            </group>
                            <separator string="Administration Total"/>
                            <group string="Total">
                                <group>
                                    <field name="admin_score" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert">
                                Administration score starts from 100, then applies absence/late/early leaving/penalty/bonus point adjustments, and is clamped between 0 and 100.
                            </div>
                        </page>

                        <!-- Same score summary as HR appraisal form (read-only) -->
                        <page string="🏅 Score" name="my_score_tab">
                            <group>
                                <group>
                                    <field name="skill_average_score" readonly="1"/>
                                    <field name="weighted_skill_score" readonly="1"/>
                                    <field name="weighted_admin_score" readonly="1"/>
                                    <field name="base_score" readonly="1"/>
                                </group>
                                <group>
                                    <field name="manual_score" readonly="1"/>
                                    <field name="manual_score_reason" readonly="1"/>
                                    <field name="total_score" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-2" role="alert">
                                Base Score = (Skill Average × 70%) + (Administration × 30%).
                                Total Score = Base Score + Manual Adjustment (limit set in Administration Score Configuration), capped at 100%.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for "My Appraisals" menu -->
    <record id="sl_action_my_appraisals" model="ir.actions.act_window">
        <field name="name">My Appraisals</field>
        <field name="res_model">hr.appraisal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_user_id', '=', uid)]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sl_my_appraisals_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sl_my_appraisals_view_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No appraisals yet
            </p>
            <p>
                Your appraisals will appear here once HR creates them.
                You'll be able to track your skill progression over time.
            </p>
        </field>
    </record>

</odoo>
