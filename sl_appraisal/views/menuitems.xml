<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         MAIN APPRAISALS MENU (replaces oh_appraisal menu)
         ============================================================ -->

    <!-- Override the existing oh_appraisal action on the main menu -->
    <record id="oh_appraisal.hr_appraisal_menu" model="ir.ui.menu">
        <field name="action" ref="sl_appraisal.sl_hr_appraisal_action"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_manager'),
            ref('sl_appraisal.group_appraisal_hr'),
            ref('sl_appraisal.group_appraisal_administrator')
        ])]"/>
    </record>

    <record id="oh_appraisal.hr_appraisal_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_manager'),
            ref('sl_appraisal.group_appraisal_hr'),
            ref('sl_appraisal.group_appraisal_administrator')
        ])]"/>
    </record>

    <!-- Hide unwanted submenus -->
    <record id="oh_appraisal.hr_appraisal_menu_answers" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="sl_menu_admin_score_config"
              name="Administration Score Configuration"
              parent="oh_appraisal.hr_appraisal_menu_root"
              action="sl_appraisal.action_open_admin_score_config"
              sequence="40"
              groups="sl_appraisal.group_appraisal_administrator,base.group_system"/>

    <menuitem id="sl_menu_appraisal_model"
              name="Appraisal Model"
              parent="oh_appraisal.hr_appraisal_menu_root"
              action="sl_hr_appraisal_action"
              sequence="14"
              groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr"/>

    <record id="sl_menu_appraisal_model" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ============================================================
         MY APPRAISALS MENU — for employees
         ============================================================ -->
    <record id="sl_menu_my_appraisals" model="ir.ui.menu">
        <field name="name">My Appraisals</field>
        <field name="active" eval="True"/>
        <field name="parent_id" eval="False"/>
        <field name="action" ref="sl_appraisal.sl_action_my_appraisals"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('samalink_security_groups.group_samalink_employee')
        ])]"/>
    </record>

    <!-- ============================================================
         WHITELIST for samalink_security_groups
         ============================================================ -->

    <!-- Add main Appraisal menus to HR Officer whitelist -->
    <record id="sl_appraisal.group_appraisal_hr" model="res.groups">
        <field name="whitelisted_menu_ids" eval="[
            (4, ref('oh_appraisal.hr_appraisal_menu_root')),
            (4, ref('oh_appraisal.hr_appraisal_menu')),
            (4, ref('sl_appraisal.sl_menu_appraisal_batches')),
            (4, ref('sl_appraisal.sl_menu_admin_score_config'))
        ]"/>
        <field name="menu_access" eval="[
            (4, ref('oh_appraisal.hr_appraisal_menu_root')),
            (4, ref('oh_appraisal.hr_appraisal_menu')),
            (4, ref('sl_appraisal.sl_menu_appraisal_batches')),
            (4, ref('sl_appraisal.sl_menu_admin_score_config'))
        ]"/>
    </record>

    <record id="sl_appraisal.group_appraisal_administrator" model="res.groups">
        <field name="whitelisted_menu_ids" eval="[
            (4, ref('oh_appraisal.hr_appraisal_menu_root')),
            (4, ref('oh_appraisal.hr_appraisal_menu')),
            (4, ref('sl_appraisal.sl_menu_appraisal_batches'))
        ]"/>
        <field name="menu_access" eval="[
            (4, ref('oh_appraisal.hr_appraisal_menu_root')),
            (4, ref('oh_appraisal.hr_appraisal_menu')),
            (4, ref('sl_appraisal.sl_menu_appraisal_batches'))
        ]"/>
    </record>

    <!-- Appraisal manager whitelist -->
    <record id="sl_appraisal.group_appraisal_manager" model="res.groups">
        <field name="whitelisted_menu_ids" eval="[
            (4, ref('oh_appraisal.hr_appraisal_menu_root')),
            (4, ref('oh_appraisal.hr_appraisal_menu'))
        ]"/>
        <field name="menu_access" eval="[
            (4, ref('oh_appraisal.hr_appraisal_menu_root')),
            (4, ref('oh_appraisal.hr_appraisal_menu'))
        ]"/>
    </record>

    <!-- My Appraisals should be employee-only -->
    <record id="samalink_security_groups.group_samalink_employee" model="res.groups">
        <field name="whitelisted_menu_ids" eval="[
            (4, ref('sl_menu_my_appraisals'))
        ]"/>
        <field name="menu_access" eval="[
            (4, ref('sl_menu_my_appraisals'))
        ]"/>
    </record>

</odoo>
