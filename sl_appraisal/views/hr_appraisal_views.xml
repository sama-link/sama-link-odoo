<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         APPRAISAL FORM VIEW — overrides oh_appraisal form
         ============================================================ -->
    <record id="sl_hr_appraisal_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.view.form.sl</field>
        <field name="model">hr.appraisal</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Workflow buttons -->
                    <button name="action_populate_skills"
                            string="📋 Populate Skills"
                            type="object"
                            class="btn-secondary"
                            groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state != 'draft' or skills_populated == True"
                            confirm="This will populate skills from the employee's current skill profile. Continue?"/>
                    <button name="action_refresh_skills_from_job"
                            string="🔄 Refresh Skills"
                            type="object"
                            class="btn-secondary"
                            groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state != 'draft'"
                            confirm="This will sync appraisal skills from the employee card only (one line per employee skill). Continue?"/>
                    <button name="action_publish"
                            string="📤 Publish"
                            type="object"
                            class="oe_highlight"
                            groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state != 'draft'"
                            confirm="This will publish the appraisal. Continue?"/>
                    <button name="action_sync_hr_scores_from_manager"
                            string="Sync HR Scores from Manager"
                            type="object"
                            class="btn-secondary"
                            groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state != 'submitted'"
                            confirm="This will copy Manager Feedback Score to HR Skill Score on all skill lines. Continue?"/>
                    <button name="action_hr_finalize"
                            string="✅ HR Finalize &amp; Apply Skills"
                            type="object"
                            class="oe_highlight"
                            groups="sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state != 'submitted'"
                            confirm="This will finalize the appraisal and apply approved skill levels to the employee card. Continue?"/>
                    <button name="action_submit"
                            string="🗂 Submit"
                            type="object"
                            class="btn-secondary"
                            groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state != 'published'"
                            confirm="This will lock manager feedback and move appraisal to Submitted. Continue?"/>
                    <button name="action_reset_to_draft"
                            string="↩ Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"
                            invisible="state == 'draft'"
                            confirm="This will reset the appraisal to Draft state. Continue?"/>
                    <!-- Status bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,submitted,hr_finalization"/>
                </header>
                <sheet>
                    <field name="has_active_contract_in_period" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="has_active_contract_in_period">
                        ⚠ This employee has <b>no active contract</b> covering the appraisal period
                        (<field name="date_from" readonly="1" class="oe_inline"/> →
                        <field name="date_to" readonly="1" class="oe_inline"/>).
                        Check the hire/departure dates before appraising.
                    </div>
                    <!-- Title -->
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1>
                            <field name="employee_id" class="oe_inline"
                                   placeholder="Employee's Name"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </h1>
                        <h2>
                            <field name="job_id" readonly="1"/>
                        </h2>
                    </div>

                    <!-- Main info -->
                    <group>
                        <group>
                            <field name="appraisal_deadline"
                                   readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                            <field name="creater_id" string="Created By"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="final_interview"
                                   invisible="state != 'hr_finalization'"
                                   readonly="1"/>
                            <field name="skill_line_count" string="Skills Evaluated"/>
                            <field name="skill_average_score" readonly="1"/>
                            <field name="admin_score" readonly="1"/>
                            <field name="manual_score" readonly="1"/>
                            <field name="total_score" readonly="1"/>
                        </group>
                    </group>

                    <!-- Hidden technical fields -->
                    <field name="is_hr_or_admin" invisible="1"/>
                    <field name="is_appraisal_admin" invisible="1"/>
                    <field name="is_in_access_plan" invisible="1"/>
                    <field name="skills_populated" invisible="1"/>
                    <field name="response_id" invisible="1"/>
                    <field name="app_period_from" invisible="1"/>
                    <field name="check_draft" invisible="1"/>
                    <field name="check_sent" invisible="1"/>
                    <field name="check_done" invisible="1"/>
                    <field name="check_cancel" invisible="1"/>
                    <field name="stage_id" invisible="1"/>

                    <notebook>
                        <!-- ── Skills Evaluation Tab ── -->
                        <page string="🎯 Skills Evaluation" name="skills_evaluation">
                            <field name="appraisal_skill_line_ids" nolabel="1"
                                   context="{'default_appraisal_id': id}">
                                <list editable="bottom"
                                      create="false"
                                      delete="false"
                                      decoration-success="level_change == 'improved'"
                                      decoration-danger="level_change == 'declined'"
                                      decoration-info="level_change == 'new'">
                                    <field name="skill_type_id" readonly="1"/>
                                    <field name="skill_id" readonly="1"/>
                                    <field name="current_skill_level_id" readonly="1"/>
                                    <field name="computed_current_level_progress"
                                           widget="progressbar" readonly="1"
                                           string="Current %"/>
                                    <field name="manager_feedback_skill_level_id"
                                           string="Manager Feedback Score"
                                           readonly="state != 'published' or parent.is_in_access_plan == False"
                                           groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"/>
                                    <field name="hr_skill_score_level_id"
                                           string="HR Skill Score"
                                           readonly="state != 'submitted'"
                                           groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"/>
                                    <field name="state" column_invisible="True"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-3" role="alert"
                                 invisible="state != 'draft'">
                                <strong>📋 Draft Mode:</strong>
                                Click "Populate Skills" or "Refresh Skills" to load skills
                                from the employee card only (not directly from the job position).
                            </div>
                            <div class="alert alert-warning mt-3" role="alert"
                                 invisible="state != 'published'">
                                <strong>📝 Published:</strong>
                                Managers can now propose new skill levels.
                                HR can set the final approved levels.
                            </div>
                            <div class="alert alert-success mt-3" role="alert"
                                 invisible="state != 'hr_finalization'">
                                <strong>✅ Finalized:</strong>
                                Approved skill levels have been applied to the employee card.
                            </div>
                            <div class="alert alert-secondary mt-3" role="alert"
                                 invisible="state != 'submitted'">
                                <strong>🗂 Submitted:</strong>
                                Manager feedback is locked. Only Appraisal Administrator can modify records.
                            </div>
                        </page>

                        <page string="🔐 Access Plan" name="plan"
                              groups="sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system">
                            <field name="allowed_manager_ids" invisible="1"/>
                            <div class="alert alert-info mb-3" role="alert">
                                Select who can access this appraisal (manager or employee).
                            </div>
                            <group>
                                <group>
                                    <field name="hr_manager_ids"
                                           invisible="1"
                                           readonly="1"/>
                                    <field name="hr_employee_ids"
                                           invisible="1"
                                           readonly="1"/>
                                    <field name="hr_manager_id"
                                           readonly="state != 'draft'"
                                           domain="[('id', 'in', allowed_manager_ids)]"
                                           options="{'no_create': True}"/>
                                    <field name="hr_employee_id"
                                           readonly="state != 'draft'"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="🧮 Administration Score" name="administration_score_tab"
                              groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system">
                            <field name="admin_score_exempt" invisible="1"/>
                            <div class="alert alert-info" role="alert" invisible="not admin_score_exempt">
                                This employee is in the administrative exclusion list — Administration Score is fixed at 100%.
                            </div>
                            <group string="Period">
                                <group>
                                    <field name="period_days" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Score Components"/>
                            <group col="2">
                                <group string="Absence">
                                    <field name="absence_count" readonly="1"/>
                                    <field name="absence_score" readonly="1"/>
                                </group>
                                <group string="Late Arrival">
                                    <field name="late_count" readonly="1"/>
                                    <field name="late_score" readonly="1"/>
                                </group>
                            </group>
                            <group col="2">
                                <group string="Early Leaving">
                                    <field name="early_leaving_count" readonly="1"/>
                                    <field name="early_leaving_score" readonly="1"/>
                                </group>
                                <group string="Penalties">
                                    <field name="penalty_count" readonly="1"/>
                                    <field name="penalty_score" readonly="1"/>
                                </group>
                            </group>
                            <group col="2">
                                <group string="Bonuses">
                                    <field name="bonus_count" readonly="1"/>
                                    <field name="bonus_score" readonly="1"/>
                                </group>
                                <group/>
                            </group>
                            <separator string="Administration Total"/>
                            <group string="Total">
                                <group>
                                    <field name="admin_score" readonly="1"/>
                                </group>
                                <group>
                                    <button name="action_refresh_administration_score"
                                            string="Refresh Administration Score"
                                            type="object"
                                            class="btn-secondary"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert">
                                Administration score starts from 100, then applies absence/late/early leaving/penalty/bonus point adjustments, and is clamped between 0 and 100.
                            </div>
                        </page>

                        <page string="🏅 Score" name="score_tab"
                              groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system">
                            <group>
                                <group>
                                    <field name="skill_average_score" readonly="1"/>
                                    <field name="weighted_skill_score" readonly="1"/>
                                    <field name="weighted_admin_score" readonly="1"/>
                                    <field name="base_score" readonly="1"/>
                                </group>
                                <group>
                                    <field name="manual_score"
                                           readonly="state != 'published' or is_in_access_plan == False"
                                           groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"/>
                                    <field name="manual_score_reason"
                                           readonly="state != 'published' or is_in_access_plan == False"
                                           required="manual_score != 0"
                                           groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"/>
                                    <field name="total_score"
                                           readonly="is_appraisal_admin == False or state != 'submitted'"
                                           groups="sl_appraisal.group_appraisal_manager,sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,base.group_system"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-2" role="alert">
                                Base Score = (Skill Average × 70%) + (Administration × 30%).
                                Total Score = Base Score + Manual Adjustment (limit set in Administration Score Configuration), capped at 100%.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         APPRAISAL LIST VIEW
         ============================================================ -->
    <record id="sl_hr_appraisal_view_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.view.list.sl</field>
        <field name="model">hr.appraisal</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'hr_finalization'"
                  decoration-primary="state == 'submitted'"
                  decoration-info="state == 'published'"
                  decoration-bf="state == 'draft'">
                <field name="employee_id"/>
                <field name="job_id" optional="show"/>
                <field name="appraisal_deadline"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'hr_finalization'"
                       decoration-primary="state == 'submitted'"
                       decoration-warning="state == 'published'"
                       decoration-info="state == 'draft'"/>
                <field name="skill_line_count" string="Skills"/>
                <field name="creater_id" string="Created By" optional="show"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         APPRAISAL KANBAN VIEW
         ============================================================ -->
    <record id="sl_hr_appraisal_view_kanban" model="ir.ui.view">
        <field name="name">hr.appraisal.view.kanban.sl</field>
        <field name="model">hr.appraisal</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false"
                    records_draggable="false" class="o_kanban_small_column">
                <field name="color"/>
                <field name="state"/>
                <field name="employee_id"/>
                <field name="appraisal_deadline"/>
                <field name="skill_line_count"/>
                <progressbar field="state"
                             colors='{"draft": "info", "published": "warning", "submitted": "primary", "hr_finalization": "success"}'/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="employee_id" widget="image"
                                   options="{'preview_image': 'avatar_128'}"/>
                        </aside>
                        <main>
                            <field name="employee_id" class="fw-bold fs-5"/>
                            <div class="d-flex justify-content-between mt-1">
                                <span class="text-muted">
                                    <i class="fa fa-calendar-o me-1"/>
                                    <field name="appraisal_deadline"/>
                                </span>
                            </div>
                            <div class="d-flex gap-3 mt-2">
                                <span class="badge rounded-pill text-bg-primary">
                                    <i class="fa fa-star me-1"/>
                                    <field name="skill_line_count"/> Skills
                                </span>
                                <span class="badge rounded-pill text-bg-secondary">
                                    <i class="fa fa-pencil me-1"/>
                                    <field name="state"/> Status
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         SEARCH VIEW
         ============================================================ -->
    <record id="sl_hr_appraisal_view_search" model="ir.ui.view">
        <field name="name">hr.appraisal.view.search.sl</field>
        <field name="model">hr.appraisal</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="creater_id" string="Created By"/>
                <separator/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <filter name="filter_submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_finalized" string="HR Finalized"
                        domain="[('state', '=', 'hr_finalization')]"/>
                <separator/>
                <filter name="filter_my_appraisals" string="My Appraisals"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="filter_my_team" string="My Team"
                        domain="['|', ('hr_manager_ids.user_id', '=', uid),
                                      ('employee_id.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_deadline" string="Deadline"
                            context="{'group_by': 'appraisal_deadline:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ACTION (force-use SL views on existing OH action)
         ============================================================ -->
    <record id="oh_appraisal.hr_appraisal_action" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">hr.appraisal</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- One's own appraisal is reachable only via My Appraisals; the
             management list never shows the current user's own record. -->
        <field name="domain">[('employee_id.user_id', '!=', uid)]</field>
        <field name="search_view_id" ref="sl_hr_appraisal_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first appraisal
            </p>
            <p>
                Appraisals help evaluate employee skills and performance.
                Only HR Officers and Administrators can create appraisals.
            </p>
        </field>
    </record>

    <!-- Backward-compatible action id to avoid missing action errors
         on instances that previously used sl_hr_appraisal_action. -->
    <record id="sl_hr_appraisal_action" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">hr.appraisal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('employee_id.user_id', '!=', uid)]</field>
        <field name="search_view_id" ref="sl_hr_appraisal_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first appraisal
            </p>
        </field>
    </record>

    <record id="sl_hr_appraisal_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="sl_hr_appraisal_view_kanban"/>
        <field name="act_window_id" ref="oh_appraisal.hr_appraisal_action"/>
    </record>

    <record id="sl_hr_appraisal_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sl_hr_appraisal_view_tree"/>
        <field name="act_window_id" ref="oh_appraisal.hr_appraisal_action"/>
    </record>

    <record id="sl_hr_appraisal_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sl_hr_appraisal_view_form"/>
        <field name="act_window_id" ref="oh_appraisal.hr_appraisal_action"/>
    </record>

    <record id="sl_hr_appraisal_action_view_kanban_legacy" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="sl_hr_appraisal_view_kanban"/>
        <field name="act_window_id" ref="sl_hr_appraisal_action"/>
    </record>

    <record id="sl_hr_appraisal_action_view_list_legacy" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sl_hr_appraisal_view_tree"/>
        <field name="act_window_id" ref="sl_hr_appraisal_action"/>
    </record>

    <record id="sl_hr_appraisal_action_view_form_legacy" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sl_hr_appraisal_view_form"/>
        <field name="act_window_id" ref="sl_hr_appraisal_action"/>
    </record>

    <!-- ============================================================
         BULK STATE ACTIONS (list-view "Actions" gear menu)
         ============================================================ -->
    <record id="action_appraisal_batch_publish" model="ir.actions.server">
        <field name="name">Publish (Draft → Published)</field>
        <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_administrator'),
            ref('base.group_system'),
        ])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_publish()</field>
    </record>

    <record id="action_appraisal_batch_submit" model="ir.actions.server">
        <field name="name">Submit (Published → Submitted)</field>
        <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_administrator'),
            ref('base.group_system'),
        ])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_submit()</field>
    </record>

    <record id="action_appraisal_batch_hr_finalize" model="ir.actions.server">
        <field name="name">HR Finalize (Submitted → Finalized)</field>
        <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_administrator'),
            ref('base.group_system'),
        ])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_hr_finalize()</field>
    </record>

    <record id="action_appraisal_batch_reset_to_draft" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_administrator'),
            ref('base.group_system'),
        ])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_reset_to_draft()</field>
    </record>

    <record id="action_sync_hr_scores_from_manager" model="ir.actions.server">
        <field name="name">Sync HR Scores from Manager</field>
        <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_model_id" ref="oh_appraisal.model_hr_appraisal"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('sl_appraisal.group_appraisal_hr'),
            ref('sl_appraisal.group_appraisal_administrator'),
            ref('base.group_system'),
        ])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_sync_hr_scores_from_manager()</field>
    </record>

</odoo>
