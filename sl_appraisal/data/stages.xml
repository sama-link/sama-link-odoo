<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Replace old stages with our 3-stage system.
             We keep them for backward compatibility with the oh_appraisal
             kanban grouping, but our workflow uses the 'state' field. -->
        <record id="oh_appraisal.hr_appraisal_start" model="hr.appraisal.stages">
            <field name="name">Draft</field>
            <field name="sequence">0</field>
        </record>
        <record id="oh_appraisal.hr_appraisal_sent" model="hr.appraisal.stages">
            <field name="name">Published</field>
            <field name="sequence">1</field>
        </record>
        <record id="oh_appraisal.hr_appraisal_done" model="hr.appraisal.stages">
            <field name="name">HR Finalization</field>
            <field name="sequence">2</field>
        </record>
        <!-- Deactivate Cancel stage — not part of new workflow -->
        <record id="oh_appraisal.hr_appraisal_cancel" model="hr.appraisal.stages">
            <field name="name">Cancelled</field>
            <field name="sequence">99</field>
            <field name="fold">True</field>
        </record>
    </data>
</odoo>
