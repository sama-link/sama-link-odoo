<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             APPRAISAL RECORD RULES
             ============================================================ -->

        <!-- Employee: can read only their own appraisals -->
        <record id="sl_appraisal_rule_employee_read" model="ir.rule">
            <field name="name">Appraisal: Employee sees own appraisals</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager (internal user): can read/write appraisals where
             they are an assigned evaluator or the employee's direct manager -->
        <record id="sl_appraisal_rule_manager" model="ir.rule">
            <field name="name">Appraisal: Manager/Coach access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">['|', '|',
                ('hr_manager_ids.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.coach_id.user_id', '=', user.id)
            ]</field>
            <field name="groups"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Officer: full access to all appraisals -->
        <record id="sl_appraisal_rule_hr_officer" model="ir.rule">
            <field name="name">Appraisal: HR Officer full access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             SKILL LINE RECORD RULES
             ============================================================ -->

        <!-- Employee: can read only their own skill lines -->
        <record id="sl_skill_line_rule_employee" model="ir.rule">
            <field name="name">Skill Line: Employee sees own</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: can read/write skill lines for their team -->
        <record id="sl_skill_line_rule_manager" model="ir.rule">
            <field name="name">Skill Line: Manager access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">['|', '|',
                ('appraisal_id.hr_manager_ids.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.coach_id.user_id', '=', user.id)
            ]</field>
            <field name="groups"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Officer: full access to all skill lines -->
        <record id="sl_skill_line_rule_hr" model="ir.rule">
            <field name="name">Skill Line: HR full access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             SKILL TIMELINE RECORD RULES
             ============================================================ -->
        <record id="sl_skill_history_rule_employee" model="ir.rule">
            <field name="name">Skill History: Employee sees own</field>
            <field name="model_id" ref="model_appraisal_skill_history"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sl_skill_history_rule_hr" model="ir.rule">
            <field name="name">Skill History: HR full</field>
            <field name="model_id" ref="model_appraisal_skill_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             SURVEY ANSWER ACCESS RULES (appraisal related)
             ============================================================ -->
        <record id="sl_survey_answer_rule_manager_coach" model="ir.rule">
            <field name="name">Survey Answers: Appraisal manager/coach access</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="domain_force">['|',
                ('appraisal_id', '=', False),
                '|', '|',
                ('appraisal_id.hr_manager_ids.user_id', '=', user.id),
                ('appraisal_id.employee_id.parent_id.user_id', '=', user.id),
                ('appraisal_id.employee_id.coach_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sl_survey_answer_rule_hr_admin" model="ir.rule">
            <field name="name">Survey Answers: HR/Admin full access</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_hr_officer')),
                          (4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             DISABLE OLD oh_appraisal GLOBAL RULES
             (They conflict with our new, stricter rules)
             ============================================================ -->
        <record id="oh_appraisal.hr_appraisal_rule_employee" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="oh_appraisal.hr_appraisal_rule_manager" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
