<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             APPRAISAL RECORD RULES
             ============================================================ -->

        <!-- Employee: can read only their own appraisals -->
        <record id="sl_appraisal_rule_employee_read" model="ir.rule">
            <field name="name">Appraisal: Employee sees own appraisals</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- General Manager: can read/write appraisals where they are an evaluator -->
        <record id="sl_appraisal_rule_general_manager" model="ir.rule">
            <field name="name">Appraisal: General Manager access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">['|',
                ('hr_manager_ids.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_sl_general_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Coach Manager: can read/write appraisals where they are assigned -->
        <record id="sl_appraisal_rule_coach_manager" model="ir.rule">
            <field name="name">Appraisal: Coach Manager access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">['|',
                ('hr_manager_ids.user_id', '=', user.id),
                ('employee_id.coach_id.user_id', '=', user.id)
            ]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_sl_coach_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Officer: full access to all appraisals -->
        <record id="sl_appraisal_rule_hr_officer" model="ir.rule">
            <field name="name">Appraisal: HR Officer full access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             SKILL LINE RECORD RULES
             ============================================================ -->

        <!-- Employee: can read only their own skill lines -->
        <record id="sl_skill_line_rule_employee" model="ir.rule">
            <field name="name">Skill Line: Employee sees own</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: can read/write skill lines for their team -->
        <record id="sl_skill_line_rule_manager" model="ir.rule">
            <field name="name">Skill Line: Manager access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">['|',
                ('appraisal_id.hr_manager_ids.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_sl_general_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Officer: full access to all skill lines -->
        <record id="sl_skill_line_rule_hr" model="ir.rule">
            <field name="name">Skill Line: HR full access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('samalink_security_groups.group_samalink_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             DISABLE OLD oh_appraisal GLOBAL RULES
             (They conflict with our new, stricter rules)
             ============================================================ -->
        <record id="oh_appraisal.hr_appraisal_rule_employee" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="oh_appraisal.hr_appraisal_rule_manager" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
