<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             APPRAISAL RECORD RULES
             ============================================================ -->

        <!-- Manager: can read/write appraisals where
             they are the selected access person -->
        <record id="sl_appraisal_rule_manager" model="ir.rule">
            <field name="name">Appraisal: Manager/Coach access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[('access_user_ids', 'in', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('oh_appraisal.oh_appraisal_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Officer: full access to all appraisals -->
        <record id="sl_appraisal_rule_hr_officer" model="ir.rule">
            <field name="name">Appraisal: HR Officer full access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_hr'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="sl_appraisal_rule_admin" model="ir.rule">
            <field name="name">Appraisal: Administrator full access</field>
            <field name="model_id" ref="oh_appraisal.model_hr_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_administrator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             SKILL LINE RECORD RULES
             ============================================================ -->

        <!-- Manager: can read/write skill lines for their team -->
        <record id="sl_skill_line_rule_manager" model="ir.rule">
            <field name="name">Skill Line: Manager access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[('appraisal_id.access_user_ids', 'in', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('oh_appraisal.oh_appraisal_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Officer: full access to all skill lines -->
        <record id="sl_skill_line_rule_hr" model="ir.rule">
            <field name="name">Skill Line: HR full access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_hr'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="sl_skill_line_rule_admin" model="ir.rule">
            <field name="name">Skill Line: Administrator full access</field>
            <field name="model_id" ref="model_appraisal_skill_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_administrator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             SKILL TIMELINE RECORD RULES
             ============================================================ -->
        <record id="sl_skill_history_rule_hr" model="ir.rule">
            <field name="name">Skill History: HR full</field>
            <field name="model_id" ref="model_appraisal_skill_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_hr'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="sl_skill_history_rule_admin" model="ir.rule">
            <field name="name">Skill History: Administrator full</field>
            <field name="model_id" ref="model_appraisal_skill_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_administrator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             MANAGER FEEDBACK RECORD RULES
             ============================================================ -->
        <record id="sl_manager_feedback_rule_user_own" model="ir.rule">
            <field name="name">Manager Feedback: own records only</field>
            <field name="model_id" ref="model_appraisal_skill_manager_feedback"/>
            <field name="domain_force">[('manager_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oh_appraisal.oh_appraisal_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="sl_manager_feedback_rule_hr" model="ir.rule">
            <field name="name">Manager Feedback: HR/Admin full</field>
            <field name="model_id" ref="model_appraisal_skill_manager_feedback"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_appraisal.group_appraisal_hr')),
                          (4, ref('sl_appraisal.group_appraisal_administrator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Keep survey.user_input rules from upstream modules to avoid
             blocking generic survey access in non-appraisal contexts. -->

        <!-- ============================================================
             DISABLE OLD oh_appraisal GLOBAL RULES
             (They conflict with our new, stricter rules)
             ============================================================ -->
        <record id="oh_appraisal.hr_appraisal_rule_employee" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="oh_appraisal.hr_appraisal_rule_manager" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="oh_appraisal.oh_appraisal_group_employee" model="res.groups">
            <field name="implied_ids" eval="[(5, 0, 0)]"/>
        </record>
        <record id="oh_appraisal.access_hr_appraisal_user" model="ir.model.access">
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>
</odoo>
