<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="recalculate_overtime_wizard_form" model="ir.ui.view">
        <field name="name">recalculate.overtime.wizard.form</field>
        <field name="model">recalculate.overtime.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalculate Overtime">
                <group>
                    <group string="Selection">
                        <field name="selected_count"/>
                        <field name="approved_count"/>
                        <field name="refused_count"/>
                    </group>
                    <group string="Options">
                        <field name="force_update_approved"/>
                        <field name="reset_refused_to_approve"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    This recomputes the daily overtime reservoir for each affected
                    (employee, day) from the employee's current working schedule,
                    then refreshes the overtime hours on the selected attendance
                    records and on their same-day siblings for that employee.
                </div>
                <footer>
                    <button string="Recalculate" type="object" name="action_recalculate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_recalculate_overtime_wizard" model="ir.actions.act_window">
        <field name="name">Recalculate Overtime</field>
        <field name="res_model">recalculate.overtime.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
