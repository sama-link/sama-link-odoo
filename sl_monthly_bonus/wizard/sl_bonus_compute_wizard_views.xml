<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_compute_wizard_form" model="ir.ui.view">
            <field name="name">sl.bonus.compute.wizard.form</field>
            <field name="model">sl.bonus.compute.wizard</field>
            <field name="arch" type="xml">
                <form string="Compute Bonuses">
                    <div class="alert alert-info" role="alert" invisible="scope != 'selected'">
                        🎯 <strong>Per-employee compute.</strong>
                        Pick the employees whose bonus you want to refresh. Only their lines
                        will be recomputed; the rest of the batch stays as-is. Manual overrides
                        on the chosen lines are preserved.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="scope != 'all'">
                        ♻ <strong>Full recompute.</strong>
                        All active employees in this company will be (re)computed. Manual
                        overrides are preserved across the run.
                    </div>
                    <group>
                        <field name="batch_id" readonly="1"/>
                        <field name="scope" widget="radio"/>
                        <field name="employee_ids" widget="many2many_tags"
                               invisible="scope != 'selected'"
                               required="scope == 'selected'"/>
                        <field name="affected_count_preview" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_run" type="object" string="✅ Run"
                                class="oe_highlight"
                                confirm="Recompute bonuses now? Manual overrides are preserved."/>
                        <button special="cancel" string="Cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
