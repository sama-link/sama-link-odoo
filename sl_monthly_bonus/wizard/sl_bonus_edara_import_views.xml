<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_edara_import_wizard_form" model="ir.ui.view">
            <field name="name">sl.bonus.edara.import.wizard.form</field>
            <field name="model">sl.bonus.edara.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Edara Staging Data">
                    <group>
                        <field name="target_model"/>
                        <field name="file_name"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="create_sync_run"/>
                    </group>
                    <group string="CSV columns">
                        <p>
                            Common: <code>edara_external_id,date,note</code><br/>
                            Sales: <code>amount,is_collected</code><br/>
                            Stock: <code>stock_sales_value,classification</code><br/>
                            Installation: <code>completed</code>
                        </p>
                    </group>
                    <footer>
                        <button name="action_import" type="object" string="Import" class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sl_bonus_edara_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Edara Data</field>
            <field name="res_model">sl.bonus.edara.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
