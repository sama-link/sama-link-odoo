<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_batch_generate_wizard_form" model="ir.ui.view">
            <field name="name">sl.bonus.batch.generate.wizard.form</field>
            <field name="model">sl.bonus.batch.generate.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Employees">
                    <sheet>
                        <field name="batch_id" invisible="1"/>
                        <div class="o_row">
                            <field name="employee_filter" placeholder="Search employees by name or code…"/>
                            <button name="action_search" type="object" string="Search" class="btn-secondary"/>
                        </div>
                        <field name="employee_ids">
                            <list>
                                <field name="name"/>
                                <field name="department_id"/>
                                <field name="job_id"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_generate" type="object"
                                string="Select Employees" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
