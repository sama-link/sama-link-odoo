<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_batch_generate_wizard_form" model="ir.ui.view">
            <field name="name">sl.bonus.batch.generate.wizard.form</field>
            <field name="model">sl.bonus.batch.generate.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Employees">
                    <sheet>
                        <field name="batch_id" invisible="1"/>
                        <group>
                            <field name="department_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Leave empty for all departments"/>
                            <button name="action_apply_filter" type="object"
                                    string="Apply Department Filter" class="btn-link"/>
                        </group>
                        <field name="employee_ids">
                            <list>
                                <field name="name"/>
                                <field name="department_id"/>
                                <field name="job_id"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_generate" type="object"
                                string="Generate Bonus Lines" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
