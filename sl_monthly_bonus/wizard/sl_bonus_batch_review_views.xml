<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_batch_review_form" model="ir.ui.view">
            <field name="name">sl.bonus.batch.review.form</field>
            <field name="model">sl.bonus.batch.review</field>
            <field name="arch" type="xml">
                <form string="Employees Needing Review">
                    <field name="batch_id" invisible="1"/>
                    <field name="ok_employee_ids" invisible="1"/>
                    <field name="line_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert">
                        ⚠ The employees below have a contract that <b>starts or ends inside</b> the bonus period
                        <field name="period_start" readonly="1" class="oe_inline"/> →
                        <field name="period_end" readonly="1" class="oe_inline"/>.
                        Choose for each one whether to still add them to the bonus batch.
                        Other selected employees are added normally.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="line_count">
                        No employee currently needs review for this period.
                    </div>
                    <field name="line_ids" nolabel="1" invisible="not line_count">
                        <list editable="bottom" create="0" delete="0"
                              decoration-muted="decision == 'exclude'">
                            <field name="employee_id" force_save="1" readonly="1"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="issue_summary"/>
                            <field name="decision" widget="radio" options="{'horizontal': true}"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary"
                                invisible="not line_count and not ok_employee_ids"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
