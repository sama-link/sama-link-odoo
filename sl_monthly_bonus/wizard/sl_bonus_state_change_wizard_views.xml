<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_state_change_wizard_form" model="ir.ui.view">
            <field name="name">sl.bonus.state.change.wizard.form</field>
            <field name="model">sl.bonus.state.change.wizard</field>
            <field name="arch" type="xml">
                <form string="Manual State Change (Admin)">
                    <div class="alert alert-danger" role="alert">
                        ⚠ <strong>Emergency tool — Admin only.</strong>
                        Use this only when the batch is stuck. Every change is logged in the
                        Audit Log with the reason you provide.
                    </div>
                    <group>
                        <field name="batch_id" readonly="1"/>
                        <field name="current_state" readonly="1"/>
                        <field name="new_state"/>
                    </group>
                    <group string="Reason (mandatory)">
                        <field name="reason" nolabel="1" placeholder="Explain why you are forcing this state change"/>
                    </group>
                    <footer>
                        <button name="action_apply" type="object" string="🔧 Apply"
                                class="oe_highlight"
                                confirm="Force the batch into the chosen state? This is logged in the Audit Log."/>
                        <button special="cancel" string="Cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
