<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_target_tree" model="ir.ui.view">
            <field name="name">sl.bonus.target.tree</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <list string="Sales Targets">
                    <field name="employee_id"/>
                    <field name="job_id"/>
                    <field name="period_start"/>
                    <field name="target_amount"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_target_form" model="ir.ui.view">
            <field name="name">sl.bonus.target.form</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="job_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="period_start"/>
                                <field name="target_amount"/>
                                <field name="currency_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Threshold Tiers">
                                <field name="tier_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="achievement_min"/>
                                        <field name="commission_amount"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Note">
                                <field name="note" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_sl_bonus_target_search" model="ir.ui.view">
            <field name="name">sl.bonus.target.search</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="period_start"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Month" name="g_period" context="{'group_by':'period_start'}"/>
                        <filter string="Employee" name="g_employee" context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_sl_bonus_target" model="ir.actions.act_window">
            <field name="name">Sales Targets</field>
            <field name="res_model">sl.bonus.target</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
