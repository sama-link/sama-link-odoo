<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_target_tree" model="ir.ui.view">
            <field name="name">sl.bonus.target.tree</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <list string="Sales Targets &amp; Commissions" editable="bottom" open_form_view="1">
                    <field name="employee_id"/>
                    <field name="target_amount"/>
                    <field name="commission_tier_count" string="Custom Tiers"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_target_form" model="ir.ui.view">
            <field name="name">sl.bonus.target.form</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="target_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <separator string="Commission Tiers"/>
                        <div class="text-muted mb-2">
                            Commission tiers for THIS employee — the tier is picked by
                            achievement % (collected ÷ target) and pays its Commission %
                            of the collected sales. Leave the table empty to use the
                            global default tiers; use the button to copy the defaults
                            here and adjust the rates for this employee.
                        </div>
                        <button name="action_load_default_tiers"
                                string="Load Default Tiers"
                                type="object"
                                class="btn-secondary mb-2"/>
                        <field name="commission_tier_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="achievement_min"/>
                                <field name="commission_percent"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_sl_bonus_target_search" model="ir.ui.view">
            <field name="name">sl.bonus.target.search</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="g_employee" context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_sl_bonus_target" model="ir.actions.act_window">
            <field name="name">Sales Targets &amp; Commissions</field>
            <field name="res_model">sl.bonus.target</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Set each employee's sales target and commission tiers</p>
                <p>One target per employee. Open a target to manage that employee's
                   own commission tiers — employees without custom tiers use the
                   global default table.</p>
            </field>
        </record>
    </data>
</odoo>
