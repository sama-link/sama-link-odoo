<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_target_tree" model="ir.ui.view">
            <field name="name">sl.bonus.target.tree</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <list string="Sales Targets" editable="bottom">
                    <field name="employee_id"/>
                    <field name="target_amount"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_target_form" model="ir.ui.view">
            <field name="name">sl.bonus.target.form</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="target_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <div class="text-muted">
                            One target per employee, valid for all time. Commission tiers are
                            global — see Configuration → Sales Commission Tiers.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_sl_bonus_target_search" model="ir.ui.view">
            <field name="name">sl.bonus.target.search</field>
            <field name="model">sl.bonus.target</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="g_employee" context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_sl_bonus_target" model="ir.actions.act_window">
            <field name="name">Sales Targets</field>
            <field name="res_model">sl.bonus.target</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
