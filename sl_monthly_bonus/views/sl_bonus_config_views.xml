<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════════ Service Rate ════════════════════ -->
        <record id="view_sl_bonus_service_rate_tree" model="ir.ui.view">
            <field name="name">sl.bonus.service.rate.tree</field>
            <field name="model">sl.bonus.service.rate</field>
            <field name="arch" type="xml">
                <list string="Service Rates">
                    <field name="job_id"/>
                    <field name="percentage"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_service_rate_form" model="ir.ui.view">
            <field name="name">sl.bonus.service.rate.form</field>
            <field name="model">sl.bonus.service.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="percentage"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_service_rate" model="ir.actions.act_window">
            <field name="name">Service Rates</field>
            <field name="res_model">sl.bonus.service.rate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ════════════════════ Evaluation Exceptions ════════════════════ -->
        <record id="view_sl_bonus_evaluation_exception_tree" model="ir.ui.view">
            <field name="name">sl.bonus.evaluation.exception.tree</field>
            <field name="model">sl.bonus.evaluation.exception</field>
            <field name="arch" type="xml">
                <list string="Evaluation Exceptions" editable="bottom">
                    <field name="employee_id"/>
                    <field name="reason"/>
                </list>
            </field>
        </record>
        <!-- ════════════════════ Sales Commission Tiers (global) ════════════════════ -->
        <record id="view_sl_bonus_sales_tier_tree" model="ir.ui.view">
            <field name="name">sl.bonus.sales.tier.tree</field>
            <field name="model">sl.bonus.sales.tier</field>
            <field name="arch" type="xml">
                <list string="Sales Commission Tiers" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="achievement_min"/>
                    <field name="commission_percent"/>
                </list>
            </field>
        </record>
        <record id="action_sl_bonus_sales_tier" model="ir.actions.act_window">
            <field name="name">Sales Commission Tiers</field>
            <field name="res_model">sl.bonus.sales.tier</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define the global commission tiers</p>
                <p>These tiers apply to ALL sales employees. Each tier sets a minimum
                   achievement % (collected ÷ target) and the commission as a percentage
                   of that employee's own target amount.</p>
            </field>
        </record>

        <record id="action_sl_bonus_evaluation_exception" model="ir.actions.act_window">
            <field name="name">Evaluation Exceptions</field>
            <field name="res_model">sl.bonus.evaluation.exception</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add an employee to skip the evaluation factor</p>
                <p>Employees listed here have their evaluation treated as 100% in bonus
                   computation — use this for employees who never receive an appraisal
                   (whose evaluation would otherwise be 0% and zero out the bonus).</p>
            </field>
        </record>

        <!-- ════════════════════ Installation Rate ════════════════════ -->
        <record id="view_sl_bonus_installation_rate_tree" model="ir.ui.view">
            <field name="name">sl.bonus.installation.rate.tree</field>
            <field name="model">sl.bonus.installation.rate</field>
            <field name="arch" type="xml">
                <list string="Installation Fixed Bonus">
                    <field name="job_id"/>
                    <field name="fixed_amount"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_installation_rate_form" model="ir.ui.view">
            <field name="name">sl.bonus.installation.rate.form</field>
            <field name="model">sl.bonus.installation.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="fixed_amount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_installation_rate" model="ir.actions.act_window">
            <field name="name">Installation Fixed Bonus</field>
            <field name="res_model">sl.bonus.installation.rate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ════════════════════ Stock Commission ════════════════════ -->
        <record id="view_sl_bonus_stock_commission_tree" model="ir.ui.view">
            <field name="name">sl.bonus.stock.commission.tree</field>
            <field name="model">sl.bonus.stock.commission.rate</field>
            <field name="arch" type="xml">
                <list string="Stock Commission Rates">
                    <field name="job_id"/>
                    <field name="percentage"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_stock_commission_form" model="ir.ui.view">
            <field name="name">sl.bonus.stock.commission.form</field>
            <field name="model">sl.bonus.stock.commission.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="percentage"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_stock_commission_rate" model="ir.actions.act_window">
            <field name="name">Stock Commission</field>
            <field name="res_model">sl.bonus.stock.commission.rate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ════════════════════ Branch Profit Tier ════════════════════ -->
        <record id="view_sl_bonus_branch_profit_tier_tree" model="ir.ui.view">
            <field name="name">sl.bonus.branch.profit.tier.tree</field>
            <field name="model">sl.bonus.branch.profit.tier</field>
            <field name="arch" type="xml">
                <list string="Profitability Tiers" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="factor_min"/>
                    <field name="factor_max"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        <record id="action_sl_bonus_branch_profit_tier" model="ir.actions.act_window">
            <field name="name">Profitability Tiers</field>
            <field name="res_model">sl.bonus.branch.profit.tier</field>
            <field name="view_mode">list</field>
        </record>

        <!-- ════════════════════ Branch Manager Rate ════════════════════ -->
        <record id="view_sl_bonus_branch_manager_rate_tree" model="ir.ui.view">
            <field name="name">sl.bonus.branch.manager.rate.tree</field>
            <field name="model">sl.bonus.branch.manager.rate</field>
            <field name="arch" type="xml">
                <list string="Branch Manager Rates">
                    <field name="job_id"/>
                    <field name="pct_low"/>
                    <field name="pct_base"/>
                    <field name="pct_high"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_branch_manager_rate_form" model="ir.ui.view">
            <field name="name">sl.bonus.branch.manager.rate.form</field>
            <field name="model">sl.bonus.branch.manager.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <group string="Percentages per Tier">
                            <field name="pct_low"/>
                            <field name="pct_base"/>
                            <field name="pct_high"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_branch_manager_rate" model="ir.actions.act_window">
            <field name="name">Branch Manager Rates</field>
            <field name="res_model">sl.bonus.branch.manager.rate</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
