<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════════ Service Rate ════════════════════ -->
        <record id="view_sl_bonus_service_rate_tree" model="ir.ui.view">
            <field name="name">sl.bonus.service.rate.tree</field>
            <field name="model">sl.bonus.service.rate</field>
            <field name="arch" type="xml">
                <list string="Service Rates">
                    <field name="job_id"/>
                    <field name="percentage"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_service_rate_form" model="ir.ui.view">
            <field name="name">sl.bonus.service.rate.form</field>
            <field name="model">sl.bonus.service.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="percentage"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_service_rate" model="ir.actions.act_window">
            <field name="name">Service Rates</field>
            <field name="res_model">sl.bonus.service.rate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ════════════════════ Installation Rate ════════════════════ -->
        <record id="view_sl_bonus_installation_rate_tree" model="ir.ui.view">
            <field name="name">sl.bonus.installation.rate.tree</field>
            <field name="model">sl.bonus.installation.rate</field>
            <field name="arch" type="xml">
                <list string="Installation Fixed Bonus">
                    <field name="job_id"/>
                    <field name="fixed_amount"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_installation_rate_form" model="ir.ui.view">
            <field name="name">sl.bonus.installation.rate.form</field>
            <field name="model">sl.bonus.installation.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="fixed_amount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_installation_rate" model="ir.actions.act_window">
            <field name="name">Installation Fixed Bonus</field>
            <field name="res_model">sl.bonus.installation.rate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ════════════════════ Stock Commission ════════════════════ -->
        <record id="view_sl_bonus_stock_commission_tree" model="ir.ui.view">
            <field name="name">sl.bonus.stock.commission.tree</field>
            <field name="model">sl.bonus.stock.commission.rate</field>
            <field name="arch" type="xml">
                <list string="Stock Commission Rates">
                    <field name="job_id"/>
                    <field name="percentage"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_stock_commission_form" model="ir.ui.view">
            <field name="name">sl.bonus.stock.commission.form</field>
            <field name="model">sl.bonus.stock.commission.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="percentage"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_stock_commission_rate" model="ir.actions.act_window">
            <field name="name">Stock Commission</field>
            <field name="res_model">sl.bonus.stock.commission.rate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ════════════════════ Branch Profit Tier ════════════════════ -->
        <record id="view_sl_bonus_branch_profit_tier_tree" model="ir.ui.view">
            <field name="name">sl.bonus.branch.profit.tier.tree</field>
            <field name="model">sl.bonus.branch.profit.tier</field>
            <field name="arch" type="xml">
                <list string="Profitability Tiers" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="factor_min"/>
                    <field name="factor_max"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        <record id="action_sl_bonus_branch_profit_tier" model="ir.actions.act_window">
            <field name="name">Profitability Tiers</field>
            <field name="res_model">sl.bonus.branch.profit.tier</field>
            <field name="view_mode">list</field>
        </record>

        <!-- ════════════════════ Branch Manager Rate ════════════════════ -->
        <record id="view_sl_bonus_branch_manager_rate_tree" model="ir.ui.view">
            <field name="name">sl.bonus.branch.manager.rate.tree</field>
            <field name="model">sl.bonus.branch.manager.rate</field>
            <field name="arch" type="xml">
                <list string="Branch Manager Rates">
                    <field name="job_id"/>
                    <field name="pct_low"/>
                    <field name="pct_base"/>
                    <field name="pct_high"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_branch_manager_rate_form" model="ir.ui.view">
            <field name="name">sl.bonus.branch.manager.rate.form</field>
            <field name="model">sl.bonus.branch.manager.rate</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <group string="Percentages per Tier">
                            <field name="pct_low"/>
                            <field name="pct_base"/>
                            <field name="pct_high"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_branch_manager_rate" model="ir.actions.act_window">
            <field name="name">Branch Manager Rates</field>
            <field name="res_model">sl.bonus.branch.manager.rate</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
