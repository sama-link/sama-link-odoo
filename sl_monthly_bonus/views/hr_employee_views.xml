<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Bonus half of the "Appraisal & Bonus" tab that sl_appraisal adds
             to the employee form. Inherits sl_appraisal's view directly so the
             page is guaranteed to exist when this xpath runs. -->
        <record id="view_hr_employee_form_appraisal_bonus_tab" model="ir.ui.view">
            <field name="name">hr.employee.form.appraisal.bonus.tab</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="sl_appraisal.sl_view_employee_form_appraisal"/>
            <field name="arch" type="xml">
                <!-- Widen the tab to bonus managers: each inner group keeps
                     its own module's groups, so each side only sees its part. -->
                <xpath expr="//page[@name='appraisal_bonus']" position="attributes">
                    <attribute name="groups">sl_appraisal.group_appraisal_hr,sl_appraisal.group_appraisal_administrator,sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,base.group_system</attribute>
                </xpath>
                <xpath expr="//page[@name='appraisal_bonus']/group[@name='appraisal_eligibility']" position="after">
                    <group name="bonus_eligibility" string="Bonus"
                           groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin">
                        <field name="bonus_eligible"/>
                        <field name="bonus_evaluation_mode"
                               invisible="not bonus_eligible"
                               required="bonus_eligible"/>
                        <div colspan="2" class="text-muted" invisible="not bonus_eligible">"Fixed": the appraisal % is skipped (treated as 100%) in this employee's bonus formula — for employees who never receive an appraisal.</div>
                        <div colspan="2" class="text-muted" invisible="bonus_eligible">This employee cannot be added to a bonus batch.</div>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_hr_employee_form_bonus" model="ir.ui.view">
            <field name="name">hr.employee.form.bonus</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Monthly Bonus" name="bonus" groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin">
                        <group>
                            <field name="bonus_quarterly_exclusion"/>
                        </group>
                        <group string="Edara Mappings">
                            <field name="bonus_edara_mapping_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="role"/>
                                    <field name="edara_external_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="view_hr_job_form_bonus" model="ir.ui.view">
            <field name="name">hr.job.form.bonus</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <sheet position="inside">
                    <group string="Bonus" groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin">
                        <field name="bonus_category"/>
                        <div class="alert alert-warning" role="alert" invisible="bonus_category != 'none'">
                            <strong>No monthly bonus configured.</strong>
                            Employees in this job will receive 0 monthly bonus with the reason
                            "Job position has no monthly bonus category assigned." Set a category
                            and configure the matching rate in Bonus → Configuration.
                        </div>
                    </group>
                </sheet>
            </field>
        </record>
    </data>
</odoo>
