                  parent="menu_sl_bonus_edara"
                  action="action_sl_bonus_edara_sync_now_server"
                  sequence="20"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_import"
