<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <menuitem id="menu_sl_bonus_root"
                  name="Monthly Bonus"
                  sequence="55"
                  web_icon="sl_monthly_bonus,static/description/icon.png"
                  groups="sl_monthly_bonus.group_bonus_employee"/>

        <!-- ════════════════════ Bonuses (independent or batch-owned lines) ════════════════════ -->
        <menuitem id="menu_sl_bonus_lines_main"
                  name="🧮 Bonuses"
                  parent="menu_sl_bonus_root"
                  action="action_sl_bonus_lines_main"
                  sequence="5"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <!-- ════════════════════ Batches ════════════════════ -->
        <menuitem id="menu_sl_bonus_batches"
                  name="📦 Bonus Batches"
                  parent="menu_sl_bonus_root"
                  action="action_sl_bonus_batch"
                  sequence="10"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <!-- Also the Sales Manager's only bonus page: the record rule limits it
             to the Sales category, so the list shows exactly what that role may
             see. Without a menu the role has no way into bonuses at all. -->
        <menuitem id="menu_sl_bonus_batch_lines"
                  name="All Bonus Lines"
                  parent="menu_sl_bonus_root"
                  action="action_sl_bonus_batch_line"
                  sequence="15"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_open_prev_month"
                  name="Open Previous-Month Batch"
                  parent="menu_sl_bonus_root"
                  action="action_sl_bonus_batch_open_prev_month_server"
                  sequence="20"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <!-- ════════════════════ Self-Service (standalone top-level app) ════════════════════ -->
        <!-- Refinement R5: emoji removed from label (kept the existing icon
             asset). The label is the user-facing string; the app icon comes
             from web_icon. -->
        <menuitem id="menu_sl_bonus_self"
                  name="My Bonus"
                  sequence="56"
                  web_icon="sl_monthly_bonus,static/description/icon.png"
                  groups="sl_monthly_bonus.group_bonus_employee"/>

        <menuitem id="menu_sl_bonus_self_current"
                  name="My Current-Month Estimate"
                  parent="menu_sl_bonus_self"
                  action="action_sl_bonus_self_estimate_open_current"
                  sequence="10"
                  groups="sl_monthly_bonus.group_bonus_employee"/>

        <menuitem id="menu_sl_bonus_self_previous"
                  name="My Previous Bonuses"
                  parent="menu_sl_bonus_self"
                  action="action_sl_bonus_my_lines"
                  sequence="20"
                  groups="sl_monthly_bonus.group_bonus_employee"/>

        <!-- Phase-2: history menu deactivated (replaced by Previous Bonuses). -->
        <menuitem id="menu_sl_bonus_self_history"
                  name="My Estimates History"
                  parent="menu_sl_bonus_self"
                  action="action_sl_bonus_self_estimate"
                  sequence="900"
                  groups="sl_monthly_bonus.group_bonus_employee"/>

        <menuitem id="menu_sl_bonus_self_lines"
                  name="My Monthly Bonuses"
                  parent="menu_sl_bonus_self"
                  action="action_sl_bonus_my_lines"
                  sequence="901"
                  groups="sl_monthly_bonus.group_bonus_employee"/>

        <!-- ════════════════════ Edara ════════════════════ -->
        <menuitem id="menu_sl_bonus_edara"
                  name="🔄 Edara Data"
                  parent="menu_sl_bonus_root"
                  sequence="40"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>
        <!-- Restored in v18.0.2.11.x: this menu used to be deactivated by the
             "Phase 1: temporarily hidden menus" block at the end of this file,
             which re-archived it on every upgrade. Administrators now manage
             sales / stock staging rows here, so it must stay active. -->
        <record id="menu_sl_bonus_edara" model="ir.ui.menu">
            <field name="active" eval="True"/>
        </record>

        <menuitem id="menu_sl_bonus_edara_settings"
                  name="Edara Settings"
                  parent="menu_sl_bonus_edara"
                  action="action_sl_bonus_edara_settings"
                  sequence="5"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_sync"
                  name="Sync Log"
                  parent="menu_sl_bonus_edara"
                  action="action_sl_bonus_edara_sync"
                  sequence="10"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_sync_wizard"
                  name="Sync Edara (Proxy)"
                  parent="menu_sl_bonus_edara"
                  action="action_sl_bonus_edara_sync_wizard"
                  sequence="15"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_sync_now"
