                  parent="menu_sl_bonus_edara"
                  action="action_edara_staging_sales"
                  sequence="50"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <menuitem id="menu_sl_bonus_edara_staging_stock"
                  name="Staging — Stock Purchases"
                  parent="menu_sl_bonus_edara"
                  action="action_edara_staging_stock"
                  sequence="60"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_staging_install"
                  name="Staging — Installations"
                  parent="menu_sl_bonus_edara"
                  action="action_edara_staging_install"
                  sequence="70"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_staging_target"
                  name="Staging — Sales Targets (raw)"
                  parent="menu_sl_bonus_edara"
                  action="action_edara_staging_target"
                  sequence="55"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_edara_staging_branch_profit"
                  name="Staging — Branch Profitability (raw)"
                  parent="menu_sl_bonus_edara"
                  action="action_edara_staging_branch_profit"
                  sequence="75"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <!-- ════════════════════ Data Import (manual CSV) ════════════════════ -->
        <menuitem id="menu_sl_bonus_data_import"
                  name="Data Import"
                  parent="menu_sl_bonus_root"
                  sequence="45"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <menuitem id="menu_sl_bonus_csv_import"
                  name="Manual CSV Import"
                  parent="menu_sl_bonus_data_import"
                  action="action_sl_bonus_csv_import_wizard"
                  sequence="10"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <menuitem id="menu_sl_bonus_csv_import_log"
                  name="CSV Import Log"
                  parent="menu_sl_bonus_data_import"
                  action="action_sl_bonus_csv_import_log"
                  sequence="20"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <!-- ════════════════════ Branch Profitability ════════════════════ -->
        <menuitem id="menu_sl_bonus_branch_profit_root"
                  name="Branch Profitability"
                  parent="menu_sl_bonus_root"
                  action="action_sl_bonus_branch_profit"
                  sequence="50"
                  groups="sl_monthly_bonus.group_bonus_finance,sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <!-- ════════════════════ Configuration ════════════════════ -->
        <menuitem id="menu_sl_bonus_config"
                  name="⚙️ Configuration"
                  parent="menu_sl_bonus_root"
                  sequence="60"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <menuitem id="menu_sl_bonus_config_settings"
                  name="Bonus Settings"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_settings"
                  sequence="5"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_config_service"
                  name="Service Rates"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_service_rate"
                  sequence="10"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_config_target"
                  name="Sales Targets &amp; Commissions"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_target"
                  sequence="20"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin,sl_monthly_bonus.group_bonus_manager,sl_monthly_bonus.group_bonus_manager_online,sl_monthly_bonus.group_bonus_manager_projects"/>

        <menuitem id="menu_sl_bonus_config_install"
                  name="Installation Fixed Bonus"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_installation_rate"
                  sequence="30"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_config_stock"
                  name="Stock Commission"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_stock_commission_rate"
                  sequence="40"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_config_branch_tiers"
                  name="Profitability Tiers"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_branch_profit_tier"
                  sequence="50"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <menuitem id="menu_sl_bonus_config_branch_mgr_rates"
                  name="Branch Manager Rates"
                  parent="menu_sl_bonus_config"
                  action="action_sl_bonus_branch_manager_rate"
                  sequence="60"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <!-- ════════════════════ Audit ════════════════════ -->
        <menuitem id="menu_sl_bonus_audit"
                  name="📋 Audit Log"
                  parent="menu_sl_bonus_root"
                  action="action_sl_bonus_audit_log"
                  sequence="80"
                  groups="sl_monthly_bonus.group_bonus_hr_manager,sl_monthly_bonus.group_bonus_admin"/>

        <!-- ════════════════════ Phase 1: temporarily hidden menus ════════════════════
             Kept as records (active=False) instead of deleted, so their xmlids stay
             valid for security/sl_bonus_samalink_bridge.xml whitelist refs. To restore
             a menu later, set active back to True (or remove its record below).
             - "All Bonus Lines" is replaced by a smart button on the batch form.
             - Hiding the Edara Data parent hides its whole sub-tree. -->
        <record id="menu_sl_bonus_batch_lines" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_csv_import_log" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_open_prev_month" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_self_lines" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <!-- Phase 2: replaced by My Previous Bonuses (which uses the same action
             but filtered to approved/locked + own employee). -->
        <record id="menu_sl_bonus_self_history" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <!-- menu_sl_bonus_edara was removed from this hidden list in
             v18.0.2.11.x — Administrators manage staging data there now
             (see the keep-active record next to its menuitem above). -->
        <record id="menu_sl_bonus_branch_profit_root" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_audit" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_config_install" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_config_stock" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_config_branch_tiers" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="menu_sl_bonus_config_branch_mgr_rates" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
    </data>

    <!-- menuitems_whitelist gates menus per group on this deployment, so the
         groups= attributes above are not enough on their own. Runs on install
         and on every upgrade; no-op when that module is not installed. -->
    <function model="res.groups" name="_sl_bonus_sync_menu_whitelist"/>
</odoo>
