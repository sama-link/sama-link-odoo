<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sl_bonus_dashboard_graph_category" model="ir.ui.view">
            <field name="name">sl.bonus.dashboard.graph.category</field>
            <field name="model">sl.bonus.dashboard.line</field>
            <field name="arch" type="xml">
                <graph type="bar" string="Bonus by Category" sample="1">
                    <field name="category"/>
                    <field name="bonus_amount" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_sl_bonus_dashboard_graph_month" model="ir.ui.view">
            <field name="name">sl.bonus.dashboard.graph.month</field>
            <field name="model">sl.bonus.dashboard.line</field>
            <field name="arch" type="xml">
                <graph type="line" string="Monthly Bonus Trend" sample="1">
                    <field name="period_start" interval="month"/>
                    <field name="bonus_amount" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_sl_bonus_dashboard_pivot" model="ir.ui.view">
            <field name="name">sl.bonus.dashboard.pivot</field>
            <field name="model">sl.bonus.dashboard.line</field>
            <field name="arch" type="xml">
                <pivot string="Bonus Pivot" sample="1">
                    <field name="department_id" type="row"/>
                    <field name="category" type="col"/>
                    <field name="bonus_amount" type="measure"/>
                    <field name="computed_amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_sl_bonus_dashboard_list_top" model="ir.ui.view">
            <field name="name">sl.bonus.dashboard.list.top</field>
            <field name="model">sl.bonus.dashboard.line</field>
            <field name="arch" type="xml">
                <list string="Top Bonuses" create="0" delete="0" edit="0" sample="1"
                      default_order="bonus_amount desc">
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="category"/>
                    <field name="evaluation_percent" widget="progressbar"/>
                    <field name="achievement_percent" widget="progressbar"
                           optional="show"/>
                    <field name="computed_amount" optional="hide"/>
                    <field name="bonus_amount"/>
                    <field name="has_override" optional="show"/>
                    <field name="batch_state"/>
                    <field name="period_start"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_sl_bonus_dashboard_search" model="ir.ui.view">
            <field name="name">sl.bonus.dashboard.search</field>
            <field name="model">sl.bonus.dashboard.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="job_id"/>
                    <field name="work_location_id"/>
                    <field name="batch_id"/>
                    <filter string="Approved or Locked" name="f_approved"
                            domain="[('batch_state','in',['approved','locked'])]"/>
                    <filter string="Excluded" name="f_excluded" domain="[('is_excluded','=',True)]"/>
                    <filter string="Manually Adjusted" name="f_override" domain="[('has_override','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="g_cat" context="{'group_by': 'category'}"/>
                        <filter string="Department" name="g_dept" context="{'group_by': 'department_id'}"/>
                        <filter string="Branch" name="g_loc" context="{'group_by': 'work_location_id'}"/>
                        <filter string="Month" name="g_month" context="{'group_by': 'period_start:month'}"/>
                        <filter string="Batch State" name="g_state" context="{'group_by': 'batch_state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sl_bonus_dashboard" model="ir.actions.act_window">
            <field name="name">📊 Bonus Dashboard</field>
            <field name="res_model">sl.bonus.dashboard.line</field>
            <field name="view_mode">graph,pivot,list</field>
            <field name="search_view_id" ref="view_sl_bonus_dashboard_search"/>
            <field name="context">{'search_default_f_approved': 1, 'search_default_g_cat': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    📊 No bonus data to display yet.
                </p>
                <p>Once at least one batch has been computed, this dashboard shows totals,
                category mix, monthly trend, and top performers.</p>
            </field>
        </record>
    </data>
</odoo>
