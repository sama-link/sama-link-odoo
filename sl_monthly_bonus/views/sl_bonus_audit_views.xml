<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sl_bonus_audit_log_tree" model="ir.ui.view">
            <field name="name">sl.bonus.audit.log.tree</field>
            <field name="model">sl.bonus.audit.log</field>
            <field name="arch" type="xml">
                <list create="0" delete="0" edit="0">
                    <field name="create_date"/>
                    <field name="user_id"/>
                    <field name="action"/>
                    <field name="model"/>
                    <field name="res_id"/>
                    <field name="employee_id"/>
                    <field name="batch_id"/>
                    <field name="old_value"/>
                    <field name="new_value"/>
                    <field name="reason"/>
                </list>
            </field>
        </record>
        <record id="view_sl_bonus_audit_log_form" model="ir.ui.view">
            <field name="name">sl.bonus.audit.log.form</field>
            <field name="model">sl.bonus.audit.log</field>
            <field name="arch" type="xml">
                <form create="0" delete="0" edit="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="create_date" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="action" readonly="1"/>
                                <field name="model" readonly="1"/>
                                <field name="res_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="employee_id" readonly="1"/>
                                <field name="batch_id" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="old_value" readonly="1"/>
                            <field name="new_value" readonly="1"/>
                            <field name="reason" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_sl_bonus_audit_log" model="ir.actions.act_window">
            <field name="name">Audit Log</field>
            <field name="res_model">sl.bonus.audit.log</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
