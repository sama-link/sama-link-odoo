<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════════════════ Self-Service ════════════════════ -->
        <record id="rule_self_estimate_employee_own" model="ir.rule">
            <field name="name">Bonus self-estimate: employee sees only own rows</field>
            <field name="model_id" ref="model_sl_bonus_self_estimate"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="rule_self_estimate_hr_all" model="ir.rule">
            <field name="name">Bonus self-estimate: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_self_estimate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Batch lines ═════════════════════ -->
        <!-- Phase 2: employees see only their OWN APPROVED/LOCKED lines.
             Draft / computed / hr_review lines are hidden — HR must finalize
             before an employee can see the amount. -->
        <record id="rule_batch_line_employee_own" model="ir.rule">
            <field name="name">Bonus batch line: employee sees only own approved/locked</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('state', 'in', ('approved', 'locked')),
            ]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_batch_line_manager_team" model="ir.rule">
            <field name="name">Bonus batch line: team manager sees team</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <record id="rule_batch_line_hr_all" model="ir.rule">
            <field name="name">Bonus batch line: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Batch line components ═══════════ -->
        <!-- Phase 2: employees see breakdown only for own approved/locked lines. -->
        <record id="rule_batch_line_component_employee_own" model="ir.rule">
            <field name="name">Bonus line component: employee sees only own approved/locked</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[
                ('line_id.employee_id.user_id', '=', user.id),
                ('line_id.state', 'in', ('approved', 'locked')),
            ]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_batch_line_component_manager_team" model="ir.rule">
            <field name="name">Bonus line component: team manager</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[
                '|',
                ('line_id.employee_id.user_id', '=', user.id),
                ('line_id.employee_id.parent_id.user_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <record id="rule_batch_line_component_hr_all" model="ir.rule">
            <field name="name">Bonus line component: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Edara staging — employee sees only own ═══════════ -->
        <record id="rule_edara_sales_employee_own" model="ir.rule">
            <field name="name">Edara sales staging: employee sees only own</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_edara_sales_hr_all" model="ir.rule">
            <field name="name">Edara sales staging: HR all</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>
        <record id="rule_edara_stock_employee_own" model="ir.rule">
            <field name="name">Edara stock staging: employee sees only own</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_stock"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_edara_stock_hr_all" model="ir.rule">
            <field name="name">Edara stock staging: HR all</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_stock"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>
        <record id="rule_edara_install_employee_own" model="ir.rule">
            <field name="name">Edara install staging: employee sees only own</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_installation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_edara_install_hr_all" model="ir.rule">
            <field name="name">Edara install staging: HR all</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_installation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Audit log — visible to HR/Admin only ════════════ -->
        <record id="rule_audit_log_hr_only" model="ir.rule">
            <field name="name">Audit log: HR / Admin only</field>
            <field name="model_id" ref="model_sl_bonus_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>
    </data>
</odoo>
