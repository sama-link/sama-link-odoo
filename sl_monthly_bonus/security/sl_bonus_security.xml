<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════════════════ Self-Service ════════════════════ -->
        <record id="rule_self_estimate_employee_own" model="ir.rule">
            <field name="name">Bonus self-estimate: employee sees only own rows</field>
            <field name="model_id" ref="model_sl_bonus_self_estimate"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="rule_self_estimate_hr_all" model="ir.rule">
            <field name="name">Bonus self-estimate: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_self_estimate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Batch lines ═════════════════════ -->
        <!-- Phase 2: employees see only their OWN APPROVED/LOCKED lines.
             Draft / computed / hr_review lines are hidden — HR must finalize
             before an employee can see the amount. -->
        <record id="rule_batch_line_employee_own" model="ir.rule">
            <field name="name">Bonus batch line: employee sees only own approved/locked</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('state', 'in', ('approved', 'locked')),
            ]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <!-- Sales Manager: bonus lines of the Sales category only. Every other
             category is invisible to this group - not merely read-only. Rules
             of different groups are OR-ed, so an HR Manager (who inherits this
             group) still sees everything through rule_batch_line_hr_all. -->
        <record id="rule_batch_line_manager_team" model="ir.rule">
            <field name="name">Bonus batch line: sales manager sees sales category only</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[('category', '=', 'sales')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <record id="rule_batch_line_manager_online" model="ir.rule">
            <field name="name">Bonus batch line: online manager sees sales online only</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[('category', '=', 'sales_online')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_online'))]"/>
        </record>
        <record id="rule_batch_line_manager_projects" model="ir.rule">
            <field name="name">Bonus batch line: projects manager sees sales projects only</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[('category', '=', 'sales_projects')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_projects'))]"/>
        </record>
        <record id="rule_batch_line_hr_all" model="ir.rule">
            <field name="name">Bonus batch line: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Batch line components ═══════════ -->
        <!-- Phase 2: employees see breakdown only for own approved/locked lines. -->
        <record id="rule_batch_line_component_employee_own" model="ir.rule">
            <field name="name">Bonus line component: employee sees only own approved/locked</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[
                ('line_id.employee_id.user_id', '=', user.id),
                ('line_id.state', 'in', ('approved', 'locked')),
            ]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_batch_line_component_manager_team" model="ir.rule">
            <field name="name">Bonus line component: sales manager</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[('line_id.category', '=', 'sales')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <record id="rule_batch_line_component_manager_online" model="ir.rule">
            <field name="name">Bonus line component: online manager</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[('line_id.category', '=', 'sales_online')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_online'))]"/>
        </record>
        <record id="rule_batch_line_component_manager_projects" model="ir.rule">
            <field name="name">Bonus line component: projects manager</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[('line_id.category', '=', 'sales_projects')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_projects'))]"/>
        </record>
        <record id="rule_batch_line_component_hr_all" model="ir.rule">
            <field name="name">Bonus line component: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_batch_line_component"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Edara staging — employee sees only own ═══════════ -->
        <record id="rule_edara_sales_employee_own" model="ir.rule">
            <field name="name">Edara sales staging: employee sees only own</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_edara_sales_hr_all" model="ir.rule">
            <field name="name">Edara sales staging: HR all</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>
        <!-- Sales staging is the sales manager's own subject matter, and the
             employee rule he also carries would otherwise narrow this to his
             own rows. Since v18.0.2.18.0 the scope is the sales CATEGORY, not
             all rows — the function write below applies that to databases
             that already hold this noupdate record. -->
        <record id="rule_edara_sales_manager_all" model="ir.rule">
            <field name="name">Edara sales staging: sales manager sees sales category</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">['|', ('employee_id', '=', False),
                ('employee_id.job_id.bonus_category', '=', 'sales')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <!-- Category managers see their own category's staging rows. Unmapped
             rows (no employee resolved yet) stay visible to every manager so
             each can fix the errors of their own imports. -->
        <record id="rule_edara_sales_manager_online" model="ir.rule">
            <field name="name">Edara sales staging: online manager sees sales online</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">['|', ('employee_id', '=', False),
                ('employee_id.job_id.bonus_category', '=', 'sales_online')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_online'))]"/>
        </record>
        <record id="rule_edara_sales_manager_projects" model="ir.rule">
            <field name="name">Edara sales staging: projects manager sees sales projects</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_sales"/>
            <field name="domain_force">['|', ('employee_id', '=', False),
                ('employee_id.job_id.bonus_category', '=', 'sales_projects')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_projects'))]"/>
        </record>
        <record id="rule_edara_stock_employee_own" model="ir.rule">
            <field name="name">Edara stock staging: employee sees only own</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_stock"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_edara_stock_hr_all" model="ir.rule">
            <field name="name">Edara stock staging: HR all</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_stock"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>
        <record id="rule_edara_install_employee_own" model="ir.rule">
            <field name="name">Edara install staging: employee sees only own</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_installation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_employee'))]"/>
        </record>
        <record id="rule_edara_install_hr_all" model="ir.rule">
            <field name="name">Edara install staging: HR all</field>
            <field name="model_id" ref="model_sl_bonus_edara_staging_installation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Targets & commission tiers — per category ═══════
             v18.0.2.18.0: each category manager maintains only the targets and
             tiers of employees whose JOB carries their category. HR keeps the
             explicit sees-all rule: HR implies all three manager groups, and
             without it the OR of the three category rules would hide targets
             of employees in non-sales categories or with no job set. -->
        <record id="rule_target_manager_sales" model="ir.rule">
            <field name="name">Sales target: sales manager sees sales category</field>
            <field name="model_id" ref="model_sl_bonus_target"/>
            <field name="domain_force">[('employee_id.job_id.bonus_category', '=', 'sales')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <record id="rule_target_manager_online" model="ir.rule">
            <field name="name">Sales target: online manager sees sales online</field>
            <field name="model_id" ref="model_sl_bonus_target"/>
            <field name="domain_force">[('employee_id.job_id.bonus_category', '=', 'sales_online')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_online'))]"/>
        </record>
        <record id="rule_target_manager_projects" model="ir.rule">
            <field name="name">Sales target: projects manager sees sales projects</field>
            <field name="model_id" ref="model_sl_bonus_target"/>
            <field name="domain_force">[('employee_id.job_id.bonus_category', '=', 'sales_projects')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_projects'))]"/>
        </record>
        <record id="rule_target_hr_all" model="ir.rule">
            <field name="name">Sales target: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_target"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- Per-employee commission tiers follow their target's category; the
             global default table (no target) stays shared by all managers. -->
        <record id="rule_sales_tier_manager_sales" model="ir.rule">
            <field name="name">Commission tier: sales manager</field>
            <field name="model_id" ref="model_sl_bonus_sales_tier"/>
            <field name="domain_force">['|', ('target_id', '=', False),
                ('target_id.employee_id.job_id.bonus_category', '=', 'sales')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager'))]"/>
        </record>
        <record id="rule_sales_tier_manager_online" model="ir.rule">
            <field name="name">Commission tier: online manager</field>
            <field name="model_id" ref="model_sl_bonus_sales_tier"/>
            <field name="domain_force">['|', ('target_id', '=', False),
                ('target_id.employee_id.job_id.bonus_category', '=', 'sales_online')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_online'))]"/>
        </record>
        <record id="rule_sales_tier_manager_projects" model="ir.rule">
            <field name="name">Commission tier: projects manager</field>
            <field name="model_id" ref="model_sl_bonus_sales_tier"/>
            <field name="domain_force">['|', ('target_id', '=', False),
                ('target_id.employee_id.job_id.bonus_category', '=', 'sales_projects')]</field>
            <field name="groups" eval="[(4, ref('group_bonus_manager_projects'))]"/>
        </record>
        <record id="rule_sales_tier_hr_all" model="ir.rule">
            <field name="name">Commission tier: HR sees all</field>
            <field name="model_id" ref="model_sl_bonus_sales_tier"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Audit log — visible to HR/Admin only ════════════ -->
        <record id="rule_audit_log_hr_only" model="ir.rule">
            <field name="name">Audit log: HR / Admin only</field>
            <field name="model_id" ref="model_sl_bonus_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bonus_hr_manager'))]"/>
        </record>

        <!-- ════════════════════ Multi-company isolation (GLOBAL rules) ════════════
             Global (no groups) -> AND-combined with the group rules above, so
             users only see transactional bonus records of their allowed
             companies. Records with no company (legacy/NULL) stay visible.
             Configuration (rates, global tiers, exceptions) is intentionally
             NOT scoped — it is shared across companies. -->
        <record id="rule_batch_company" model="ir.rule">
            <field name="name">Bonus Batch: multi-company</field>
            <field name="model_id" ref="model_sl_bonus_batch"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_batch_line_company" model="ir.rule">
            <field name="name">Bonus Batch Line: multi-company</field>
            <field name="model_id" ref="model_sl_bonus_batch_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_target_company" model="ir.rule">
            <field name="name">Sales Target: multi-company</field>
            <field name="model_id" ref="model_sl_bonus_target"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_branch_profit_company" model="ir.rule">
            <field name="name">Branch Profitability: multi-company</field>
            <field name="model_id" ref="model_sl_bonus_branch_profit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_audit_log_company" model="ir.rule">
            <field name="name">Bonus Audit Log: multi-company</field>
            <field name="model_id" ref="model_sl_bonus_audit_log"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_self_estimate_company" model="ir.rule">
            <field name="name">Self Estimate: multi-company</field>
            <field name="model_id" ref="model_sl_bonus_self_estimate"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>

    <!-- The block above is noupdate="1", so edits to the two rules below would
         never reach a database that already has them. These writes do, on
         install and on every upgrade. -->
    <function model="ir.rule" name="write"
              eval="[[ref('rule_batch_line_manager_team')],
                     {'name': 'Bonus batch line: sales manager sees sales category only',
                      'domain_force': '''[('category', '=', 'sales')]'''}]"/>
    <function model="ir.rule" name="write"
              eval="[[ref('rule_batch_line_component_manager_team')],
                     {'name': 'Bonus line component: sales manager',
                      'domain_force': '''[('line_id.category', '=', 'sales')]'''}]"/>
    <!-- v18.0.2.18.0: the Sales Manager's staging view narrows from all rows
         to the sales category, symmetric with the two new category managers.
         Unmapped rows stay visible so import errors can be fixed. -->
    <function model="ir.rule" name="write"
              eval="[[ref('rule_edara_sales_manager_all')],
                     {'name': 'Edara sales staging: sales manager sees sales category',
                      'domain_force': '''['|', ('employee_id', '=', False),
                          ('employee_id.job_id.bonus_category', '=', 'sales')]'''}]"/>
</odoo>
