<?xml version="1.0" encoding="utf-8"?>
<!--
  Bridge between the existing samalink_security_groups and the bonus groups.

  Why this file exists:
    The samalink instance uses menuitems_whitelist, which filters menus for
    non-system users down to those explicitly listed on a group's
    whitelisted_menu_ids. Without this bridge, even users that "should" see
    the new Monthly Bonus app cannot see its menus.

  IMPORTANT:
    - whitelisted_menu_ids is SHARED across every app for the group, so we only
      ever ADD bonus menus with (4, ref(...)) — never (6,0,...) which would wipe
      other modules' whitelisted menus (appraisal / HR / etc.).
    - Only the CURRENTLY VISIBLE bonus menus are whitelisted here. Phase-1 hidden
      menus (active=False: Edara, Branch Profitability, Audit, previous-month,
      several Configuration rates) are intentionally omitted; if they are
      re-activated later, add them here too.

  No business logic is modified — only group implications and menu whitelist.
-->
<odoo>
    <data noupdate="0">

        <!-- Employee: the standalone "My Bonus" app + its self-service pages -->
        <record id="samalink_security_groups.group_samalink_employee" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('sl_monthly_bonus.group_bonus_employee'))]"/>
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_current')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_previous')),
            ]"/>
        </record>

        <!-- HR Officer: full bonus management (visible menus) + own My Bonus app -->
        <record id="samalink_security_groups.group_samalink_hr_officer" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('sl_monthly_bonus.group_bonus_hr_manager'))]"/>
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('sl_monthly_bonus.menu_sl_bonus_root')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_lines_main')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_batches')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_data_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_csv_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config_settings')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config_service')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config_target')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_current')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_previous')),
            ]"/>
        </record>

        <!-- Accountant: manual CSV import (Finance) + own My Bonus app -->
        <record id="samalink_security_groups.group_samalink_accountant" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('sl_monthly_bonus.group_bonus_finance'))]"/>
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('sl_monthly_bonus.menu_sl_bonus_root')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_data_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_csv_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_current')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_previous')),
            ]"/>
        </record>

        <!-- Administrator: full bonus admin (visible menus) + own My Bonus app -->
        <record id="samalink_security_groups.group_samalink_administrator" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('sl_monthly_bonus.group_bonus_admin'))]"/>
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('sl_monthly_bonus.menu_sl_bonus_root')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_lines_main')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_batches')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_data_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_csv_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_settings')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_sync')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_sync_wizard')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_sync_now')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_import')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_mapping')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_staging_sales')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_staging_stock')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_staging_install')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_staging_target')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_edara_staging_branch_profit')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config_settings')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config_service')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_config_target')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_current')),
                (4, ref('sl_monthly_bonus.menu_sl_bonus_self_previous')),
            ]"/>
        </record>

    </data>
</odoo>
