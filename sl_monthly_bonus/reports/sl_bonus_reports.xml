<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════ Report action: Employee bonus receipt ════════════════ -->
        <record id="action_report_bonus_receipt" model="ir.actions.report">
            <field name="name">Bonus Receipt</field>
            <field name="model">sl.bonus.batch.line</field>
            <field name="report_type">qweb-pdf</field>
