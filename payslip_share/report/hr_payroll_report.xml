<odoo>
    <!-- Remove the third-party "Payslip Details" report from the payslip Print menu;
         only "Payslip Details (Simple)" should remain. -->
    <record id="hr_payroll_community.hr_payslip_report_action" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="hr_payslip_report_action_simple" model="ir.actions.report">
        <field name="name">Payslip Details (Simple)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_hr_payslip"/>
        <field name="report_name">payslip_share.report_payslipdetails_simple</field>
        <field name="report_file">payslip_share.report_payslipdetails_simple</field>
        <field name="print_report_name">('%s Payslip %s - %s' % (object.employee_id.name, object.date_from, object.date_to))</field>
    </record>

    <!--Template for Payslip Details Report Simple-->
    <template id="report_payslipdetails_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Pay Slip</h2>
                        <p t-field="o.name"/>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td>
                                    <strong>Name</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id"/>
                                </td>
                                <td>
                                    <strong>Designation</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Email</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.work_email"/>
                                </td>
                                <td>
                                    <strong>Monthly Advantages in Cash</strong>
                                </td>
                                <td>
                                    <t t-set="cur" t-value="o.company_id.currency_id"/>
                                    <div t-if="o.contract_id.hra">HRA: <span t-field="o.contract_id.hra" t-options='{"widget": "monetary", "display_currency": cur}'/></div>
                                    <div t-if="o.contract_id.da">DA: <span t-field="o.contract_id.da" t-options='{"widget": "monetary", "display_currency": cur}'/></div>
                                    <div t-if="o.contract_id.travel_allowance">Travel Allowance: <span t-field="o.contract_id.travel_allowance" t-options='{"widget": "monetary", "display_currency": cur}'/></div>
                                    <div t-if="o.contract_id.meal_allowance">Meal Allowance: <span t-field="o.contract_id.meal_allowance" t-options='{"widget": "monetary", "display_currency": cur}'/></div>
                                    <div t-if="o.contract_id.medical_allowance">Medical Allowance: <span t-field="o.contract_id.medical_allowance" t-options='{"widget": "monetary", "display_currency": cur}'/></div>
                                    <div t-if="o.contract_id.other_allowance">Other Allowance: <span t-field="o.contract_id.other_allowance" t-options='{"widget": "monetary", "display_currency": cur}'/></div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Contract Start Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.contract_id.date_start"/>
                                </td>
                                <td>
                                    <strong>Bank Account</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.bank_account_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Date From</strong>
                                </td>
                                <td>
                                    <span t-field="o.date_from"/>
                                </td>
                                <td>
                                    <strong>Date To</strong>
                                </td>
                                <td>
                                    <span t-field="o.date_to"/>
                                </td>
                            </tr>
                        </table>
                        <!-- <h3>Details</h3> -->
                        <table class="table table-sm mb32">
                            <thead>
                                <tr>
                                    <th>Rule Name</th>
                                    <th>Qty</th>
                                    <th>Amount</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.details_by_salary_rule_category_ids"
                                    t-as="line">
                                    <td>
                                        <span t-field="line.salary_rule_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.amount"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.total"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>