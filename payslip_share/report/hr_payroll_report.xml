<odoo>
    <!-- Remove the third-party "Payslip Details" report from the payslip Print menu;
         only "Payslip Details (Simple)" should remain. -->
    <record id="hr_payroll_community.hr_payslip_report_action" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="hr_payslip_report_action_simple" model="ir.actions.report">
        <field name="name">Payslip Details (Simple)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_hr_payslip"/>
        <field name="report_name">payslip_share.report_payslipdetails_simple</field>
        <field name="report_file">payslip_share.report_payslipdetails_simple</field>
        <field name="print_report_name">('%s Payslip %s - %s' % (object.employee_id.name, object.date_from, object.date_to))</field>
    </record>

    <!--Template for Payslip Details Report Simple-->
    <template id="report_payslipdetails_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Pay Slip</h2>
                        <p t-field="o.name"/>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td>
                                    <strong>Name</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id"/>
                                </td>
                                <td>
                                    <strong>Designation</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Email</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.work_email"/>
                                </td>
                                <td>
                                    <strong>Monthly Advantages in Cash</strong>
                                </td>
                                <td>
                                    <t t-if="o.contract_id">
                                        <t t-set="cur" t-value="o.company_id.currency_id"/>
                                        <t t-set="adv_fields" t-value="['hra', 'da', 'travel_allowance', 'meal_allowance', 'medical_allowance', 'other_allowance']"/>
                                        <t t-set="adv_desc" t-value="o.contract_id.fields_get(adv_fields)"/>
                                        <t t-foreach="adv_fields" t-as="fname">
                                            <div t-if="o.contract_id[fname]">
                                                <span t-esc="adv_desc[fname]['string']"/>:
                                                <span t-out="o.contract_id[fname]" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                            </div>
                                        </t>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Contract Start Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.contract_id.date_start"/>
                                </td>
                                <td>
                                    <strong>Bank Account</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.bank_account_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Date From</strong>
                                </td>
                                <td>
                                    <span t-field="o.date_from"/>
                                </td>
                                <td>
                                    <strong>Date To</strong>
                                </td>
                                <td>
                                    <span t-field="o.date_to"/>
                                </td>
                            </tr>
                        </table>
                        <!-- <h3>Details</h3> -->
                        <table class="table table-sm mb32">
                            <thead>
                                <tr>
                                    <th>Rule Name</th>
                                    <th>Qty</th>
                                    <th>Amount</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="adv_codes" t-value="['HRA', 'DA', 'Meal', 'Medical', 'Travel', 'Other']"/>
                                <t t-set="sec1_codes" t-value="['REST_ALLOW', 'HOLIDAY_BONUS', 'PAID_HOLIDAY_BONUS', 'SICK_HOLIDAY_BONUS']"/>
                                <t t-set="sec2_codes" t-value="['OVERTIME_HOURS', 'INCENTIV']"/>
                                <t t-set="sec3_codes" t-value="['ADMIN_PENALTY', 'LATE_PENALTY', 'ABSENT_PENALTY']"/>
                                <t t-set="grouped" t-value="adv_codes + sec1_codes + sec2_codes + sec3_codes"/>
                                <t t-set="lines" t-value="o.details_by_salary_rule_category_ids"/>
                                <!-- Main rules; the contract cash advantages (adv_codes) are shown in the top block instead. -->
                                <t t-foreach="lines.filtered(lambda l: l.salary_rule_id.code not in grouped)" t-as="line">
                                    <t t-call="payslip_share.report_payslipdetails_simple_row"/>
                                </t>
                                <t t-set="sec" t-value="lines.filtered(lambda l: l.salary_rule_id.code in sec1_codes)"/>
                                <t t-if="sec">
                                    <tr><td colspan="4" class="table-active"><strong>البدلات</strong></td></tr>
                                    <t t-foreach="sec" t-as="line"><t t-call="payslip_share.report_payslipdetails_simple_row"/></t>
                                </t>
                                <t t-set="sec" t-value="lines.filtered(lambda l: l.salary_rule_id.code in sec2_codes)"/>
                                <t t-if="sec">
                                    <tr><td colspan="4" class="table-active"><strong>الحوافز</strong></td></tr>
                                    <t t-foreach="sec" t-as="line"><t t-call="payslip_share.report_payslipdetails_simple_row"/></t>
                                </t>
                                <t t-set="sec" t-value="lines.filtered(lambda l: l.salary_rule_id.code in sec3_codes)"/>
                                <t t-if="sec">
                                    <tr><td colspan="4" class="table-active"><strong>الجزاءات</strong></td></tr>
                                    <t t-foreach="sec" t-as="line"><t t-call="payslip_share.report_payslipdetails_simple_row"/></t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Shared row for the salary-computation table (rule name, qty, amount, total). -->
    <template id="report_payslipdetails_simple_row">
        <tr>
            <td><span t-field="line.salary_rule_id.name"/></td>
            <td><span t-field="line.quantity"/></td>
            <td class="text-right"><span t-field="line.amount" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
            <td class="text-right"><span t-field="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
        </tr>
    </template>

</odoo>