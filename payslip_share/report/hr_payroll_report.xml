<odoo>
    <!-- Remove the third-party "Payslip Details" report from the payslip Print menu;
         only "Payslip Details (Simple)" should remain. -->
    <record id="hr_payroll_community.hr_payslip_report_action" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="hr_payslip_report_action_simple" model="ir.actions.report">
        <field name="name">Payslip Details (Simple)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_hr_payslip"/>
        <field name="report_name">payslip_share.report_payslipdetails_simple</field>
        <field name="report_file">payslip_share.report_payslipdetails_simple</field>
        <field name="print_report_name">('%s Payslip %s - %s' % (object.employee_id.name, object.date_from, object.date_to))</field>
    </record>

    <!-- مفردات مرتب — Arabic salary itemization sheet.
         Sections are driven by payslip LINES (not contract fields) so every
         figure shown participates in the same arithmetic as the NET rule. -->
    <template id="report_payslipdetails_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="text-align: right; font-size: 13px;">
                        <t t-set="cur" t-value="o.company_id.currency_id"/>
                        <t t-set="months_ar" t-value="['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر']"/>
                        <!-- sudo: salary-rule code/name must render for non-payroll users
                             (e.g. employees opening their own share link). -->
                        <t t-set="L" t-value="dict((l.salary_rule_id.code, l) for l in o.sudo().line_ids)"/>
                        <t t-set="adv_specs" t-value="[('HRA', 'بدل سكن'), ('DA', 'بدل غلاء معيشة'), ('Travel', 'بدل انتقال'), ('Meal', 'بدل وجبة'), ('Medical', 'بدل علاج'), ('Other', 'بدلات أخرى')]"/>
                        <t t-set="inc_specs" t-value="[('REST_ALLOW', 'مقابل أيام الراحة'), ('HOLIDAY_BONUS', 'مقابل الاجازات الرسمية'), ('PAID_HOLIDAY_BONUS', 'مقابل الاجازات المدفوعة'), ('SICK_HOLIDAY_BONUS', 'مقابل الاجازات المرضية'), ('OVERTIME_HOURS', 'الوقت الإضافي (ساعة)'), ('INCENTIV', 'المكافآت')]"/>
                        <t t-set="ded_specs" t-value="[('ADMIN_PENALTY', 'الجزاءات الإدارية'), ('LATE_PENALTY', 'جزاء تأخير / انصراف مبكر'), ('ABSENT_PENALTY', 'جزاء الغياب بدون إذن'), ('ADVANCE', 'السلف')]"/>
                        <t t-set="adv_total" t-value="sum(L[c].total for c, lbl in adv_specs if c in L)"/>
                        <t t-set="inc_total" t-value="sum(L[c].total for c, lbl in inc_specs if c in L)"/>
                        <t t-set="ded_total" t-value="sum(L[c].total for c, lbl in ded_specs if c in L)"/>

                        <h3 class="text-center" style="margin-bottom: 16px;">
                            مفردات راتب شهر <t t-esc="months_ar[o.date_to.month - 1]"/> <t t-esc="o.date_to.year"/>
                        </h3>

                        <!-- Employee info -->
                        <table class="table table-sm table-bordered" style="direction: rtl;">
                            <tr>
                                <td style="width: 22%; background-color: #f2f2f2;"><strong>اسم الموظف</strong></td>
                                <td style="width: 28%;"><span t-field="o.employee_id.name"/></td>
                                <td style="width: 22%; background-color: #f2f2f2;"><strong>المسمى الوظيفي</strong></td>
                                <td style="width: 28%;"><span t-field="o.employee_id.job_id"/></td>
                            </tr>
                            <tr>
                                <td style="background-color: #f2f2f2;"><strong>تاريخ بداية العقد</strong></td>
                                <td>
                                    <t t-set="ds" t-value="o.contract_id.date_start"/>
                                    <t t-if="ds" t-esc="'%02d %s، %d' % (ds.day, months_ar[ds.month - 1], ds.year)"/>
                                    <t t-else="">-</t>
                                </td>
                                <td style="background-color: #f2f2f2;"><strong>الحساب البنكي</strong></td>
                                <td><t t-esc="o.employee_id.sudo().bank_account_id.acc_number or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="background-color: #f2f2f2;"><strong>تاريخ احتساب الراتب من</strong></td>
                                <td><t t-esc="'%d / %d / %d' % (o.date_from.day, o.date_from.month, o.date_from.year)"/></td>
                                <td style="background-color: #f2f2f2;"><strong>إلى</strong></td>
                                <td><t t-esc="'%d / %d / %d' % (o.date_to.day, o.date_to.month, o.date_to.year)"/></td>
                            </tr>
                        </table>

                        <!-- Basic salary + attendance days -->
                        <table class="table table-sm table-bordered" style="direction: rtl;">
                            <tr style="background-color: #d9d9d9;">
                                <th style="width: 46%;">البند</th>
                                <th style="width: 18%;" class="text-center">الكمية</th>
                                <th style="width: 18%;" class="text-center">المبلغ</th>
                                <th style="width: 18%;" class="text-center">الإجمالي</th>
                            </tr>
                            <tr>
                                <td>الراتب الأساسي</td>
                                <td class="text-center">-</td>
                                <td class="text-center">
                                    <span t-esc="L['BASIC_SALARY'].amount if 'BASIC_SALARY' in L else 0.0" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="L['BASIC_SALARY'].amount if 'BASIC_SALARY' in L else 0.0" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </td>
                            </tr>
                            <t t-set="row_label" t-value="'أيام الحضور'"/>
                            <t t-set="row_line" t-value="L.get('PRESENT_DAYS')"/>
                            <t t-call="payslip_share.report_payslipdetails_simple_row"/>
                        </table>

                        <!-- Allowances -->
                        <table class="table table-sm table-bordered" style="direction: rtl;">
                            <tr style="background-color: #d9d9d9;">
                                <th colspan="3" style="width: 82%;">البدلات</th>
                                <th style="width: 18%;" class="text-center">
                                    <span t-esc="adv_total" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </th>
                            </tr>
                            <t t-foreach="adv_specs" t-as="spec">
                                <t t-if="spec[0] in L and L[spec[0]].total">
                                    <t t-set="row_label" t-value="spec[1]"/>
                                    <t t-set="row_line" t-value="L[spec[0]]"/>
                                    <t t-call="payslip_share.report_payslipdetails_simple_row"/>
                                </t>
                            </t>
                        </table>

                        <!-- Increments -->
                        <table class="table table-sm table-bordered" style="direction: rtl;">
                            <tr style="background-color: #d9d9d9;">
                                <th colspan="3" style="width: 82%;">العلاوات</th>
                                <th style="width: 18%;" class="text-center">
                                    <span t-esc="inc_total" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </th>
                            </tr>
                            <t t-foreach="inc_specs" t-as="spec">
                                <t t-set="row_label" t-value="spec[1]"/>
                                <t t-set="row_line" t-value="L.get(spec[0])"/>
                                <t t-call="payslip_share.report_payslipdetails_simple_row"/>
                            </t>
                        </table>

                        <!-- Deductions -->
                        <table class="table table-sm table-bordered" style="direction: rtl;">
                            <tr style="background-color: #d9d9d9;">
                                <th colspan="3" style="width: 82%;">الإستقطاعات</th>
                                <th style="width: 18%;" class="text-center">
                                    <span t-esc="ded_total" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </th>
                            </tr>
                            <t t-foreach="ded_specs" t-as="spec">
                                <t t-set="row_label" t-value="spec[1]"/>
                                <t t-set="row_line" t-value="L.get(spec[0])"/>
                                <t t-set="row_abs_amount" t-value="True"/>
                                <t t-call="payslip_share.report_payslipdetails_simple_row"/>
                            </t>
                            <t t-set="row_abs_amount" t-value="False"/>
                        </table>

                        <!-- Salary summary -->
                        <table class="table table-sm table-bordered" style="direction: rtl; width: 60%;">
                            <tr style="background-color: #d9d9d9;">
                                <th colspan="2" class="text-center">ملخص الراتب</th>
                            </tr>
                            <tr>
                                <td style="width: 55%;">أيام الحضور</td>
                                <td class="text-center">
                                    <span t-esc="L['PRESENT_DAYS'].total if 'PRESENT_DAYS' in L else 0.0" t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>البدلات</td>
                                <td class="text-center">
                                    <t t-if="adv_total"><span t-esc="adv_total" t-options='{"widget": "monetary", "display_currency": cur}'/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td>العلاوات</td>
                                <td class="text-center">
                                    <t t-if="inc_total"><span t-esc="inc_total" t-options='{"widget": "monetary", "display_currency": cur}'/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td>الإستقطاعات</td>
                                <td class="text-center">
                                    <t t-if="ded_total"><span t-esc="ded_total" t-options='{"widget": "monetary", "display_currency": cur}'/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td>تسويات ادارية</td>
                                <td class="text-center">
                                    <t t-if="'OTH' in L and L['OTH'].total"><span t-esc="L['OTH'].total" t-options='{"widget": "monetary", "display_currency": cur}'/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr style="background-color: #f2f2f2;">
                                <td><strong>صافي الراتب</strong></td>
                                <td class="text-center">
                                    <strong><span t-esc="L['NET'].total if 'NET' in L else 0.0" t-options='{"widget": "monetary", "display_currency": cur}'/></strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Shared section row: label, quantity, unit amount, total.
         Zero/missing lines render as dashes, mirroring the paper form.
         row_abs_amount shows the unit amount unsigned (deduction rows). -->
    <template id="report_payslipdetails_simple_row">
        <tr>
            <td><span t-esc="row_label"/></td>
            <t t-if="row_line and row_line.total">
                <td class="text-center">
                    <t t-if="row_line.quantity" t-esc="'%g' % row_line.quantity"/>
                    <t t-else="">-</t>
                </td>
                <td class="text-center">
                    <span t-esc="abs(row_line.amount) if row_abs_amount else row_line.amount" t-options='{"widget": "monetary", "display_currency": cur}'/>
                </td>
                <td class="text-center">
                    <span t-esc="row_line.total" t-options='{"widget": "monetary", "display_currency": cur}'/>
                </td>
            </t>
            <t t-else="">
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
            </t>
        </tr>
    </template>

</odoo>
