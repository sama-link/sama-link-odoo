<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             FREELANCER TASK RECORD RULES
             ============================================================ -->

        <!-- User: full control over their OWN records only -->
        <record id="sl_freelancer_rule_user_own" model="ir.rule">
            <field name="name">Freelancer Task: User own only</field>
            <field name="model_id" ref="model_sl_freelancer_task"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_freelancer.group_sl_freelancer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Administrator: full access to all records -->
        <record id="sl_freelancer_rule_admin" model="ir.rule">
            <field name="name">Freelancer Task: Administrator full access</field>
            <field name="model_id" ref="model_sl_freelancer_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('sl_freelancer.group_sl_freelancer_admin')),
                          (4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-company compatibility -->
        <record id="sl_freelancer_rule_company" model="ir.rule">
            <field name="name">Freelancer Task: multi-company</field>
            <field name="model_id" ref="model_sl_freelancer_task"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
