<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_sl_freelancer" model="ir.module.category">
            <field name="name">Freelancer Records</field>
            <field name="description">Access to freelancer work records</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_sl_freelancer_user" model="res.groups">
            <field name="name">Freelancer / User</field>
            <field name="category_id" ref="module_category_sl_freelancer"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sl_freelancer_admin" model="res.groups">
            <field name="name">Freelancer / Administrator</field>
            <field name="category_id" ref="module_category_sl_freelancer"/>
            <field name="implied_ids"
                   eval="[(4, ref('sl_freelancer.group_sl_freelancer_user'))]"/>
        </record>

    </data>
</odoo>
