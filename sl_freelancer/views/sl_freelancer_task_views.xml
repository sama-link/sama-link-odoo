<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         FORM VIEW
         ============================================================ -->
    <record id="sl_freelancer_task_view_form" model="ir.ui.view">
        <field name="name">sl.freelancer.task.form</field>
        <field name="model">sl.freelancer.task</field>
        <field name="arch" type="xml">
            <form string="Freelancer Record">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attendances" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <div class="o_stat_info">
                                <field name="attendance_count" class="o_stat_value"/>
                                <span class="o_stat_text">Attendances</span>
                            </div>
                        </button>
                    </div>
                    <field name="can_edit_employee" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="can_edit_employee == False"
                                   options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="total_hours" widget="float_time" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Attendance Records">
                        <field name="attendance_ids" nolabel="1"
                               widget="many2many"
                               context="{'default_employee_id': employee_id}">
                            <list>
                                <field name="check_in"/>
                                <field name="check_out"/>
                                <field name="worked_hours" widget="float_time"
                                       sum="Total Hours"/>
                            </list>
                        </field>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Optional notes about this work record..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         LIST VIEW
         ============================================================ -->
    <record id="sl_freelancer_task_view_list" model="ir.ui.view">
        <field name="name">sl.freelancer.task.list</field>
        <field name="model">sl.freelancer.task</field>
        <field name="arch" type="xml">
            <list string="Freelancer Records">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="attendance_count"/>
                <field name="total_hours" widget="float_time" sum="Total Hours"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         SEARCH VIEW
         ============================================================ -->
    <record id="sl_freelancer_task_view_search" model="ir.ui.view">
        <field name="name">sl.freelancer.task.search</field>
        <field name="model">sl.freelancer.task</field>
        <field name="arch" type="xml">
            <search string="Freelancer Records">
                <field name="employee_id"/>
                <field name="description"/>
                <filter name="my_records" string="My Records"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         GRAPH VIEW
         ============================================================ -->
    <record id="sl_freelancer_task_view_graph" model="ir.ui.view">
        <field name="name">sl.freelancer.task.graph</field>
        <field name="model">sl.freelancer.task</field>
        <field name="arch" type="xml">
            <graph string="Freelancer Hours Analysis" type="bar">
                <field name="employee_id"/>
                <field name="total_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         PIVOT VIEW
         ============================================================ -->
    <record id="sl_freelancer_task_view_pivot" model="ir.ui.view">
        <field name="name">sl.freelancer.task.pivot</field>
        <field name="model">sl.freelancer.task</field>
        <field name="arch" type="xml">
            <pivot string="Freelancer Hours Analysis">
                <field name="employee_id" type="row"/>
                <field name="total_hours" type="measure"/>
                <field name="attendance_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================
         ACTIONS
         ============================================================ -->
    <record id="action_sl_freelancer_task" model="ir.actions.act_window">
        <field name="name">Freelancer Records</field>
        <field name="res_model">sl.freelancer.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sl_freelancer_task_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a freelancer work record
            </p>
            <p>
                Record a freelancer's work by selecting their attendance entries.
                The total worked hours are computed automatically.
            </p>
        </field>
    </record>

    <record id="action_sl_freelancer_analysis" model="ir.actions.act_window">
        <field name="name">Freelancer Analysis</field>
        <field name="res_model">sl.freelancer.task</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="sl_freelancer_task_view_search"/>
    </record>

</odoo>
