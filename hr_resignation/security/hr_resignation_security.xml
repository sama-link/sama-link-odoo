<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_resignation">
        <field name="name">Resignation</field>
    </record>
    <record id="group_resignation_hr" model="res.groups">
        <field name="name">Resignation/HR</field>
        <field name="category_id" ref="module_category_resignation"/>
    </record>

    <!--To view their own record only-->
    <record id="hr_resignation_rule_user" model="ir.rule">
        <field name="name">Employee Resignation User</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(6, 0, [ref('samalink_security_groups.group_samalink_employee')])]"/>
        <field name="global" eval="False"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Administrative Manager view of suboordinates (no create/unlink) -->
    <record id="hr_resignation_rule_administrative_manager" model="ir.rule">
        <field name="name">Employee Resignation Administrative Manager</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('employee_id.administrative_manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(6, 0, [ref('samalink_security_groups.group_sl_administrative_manager')])]"/>
        <field name="global" eval="False"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Only Resignation/HR sees all records. General Managers are NOT
         resignation managers: without this group they fall back to their
         own record (employee rule) / administrative-manager scope only. -->
    <record id="hr_resignation_rule_manager" model="ir.rule">
        <field name="name">Employee Resignation Manager</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(6, 0, [ref('hr_resignation.group_resignation_hr')])]"/>
        <field name="global" eval="False"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <!-- Access to their own contracts-->
    <record id="hr_contract_rule_user" model="ir.rule">
        <field name="name">Employee: Own Contracts</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(6, 0, [ref('samalink_security_groups.group_samalink_employee')])]"/>
    </record>
</odoo>
