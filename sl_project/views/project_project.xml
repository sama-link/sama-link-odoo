<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="edit_project" model="ir.ui.view">
            <field name="name">project.project.inherit.edit_project</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <!-- Published date + multi Company in the form body (under Tags),
                     not in the header. -->
                <field name="tag_ids" position="after">
                    <field name="use_published_date"/>
                    <field name="company_ids"
                           string="Company"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           groups="base.group_multi_company"/>
                </field>
                <!-- Hide every core company_id widget (can appear more than once). -->
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
