<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="edit_project" model="ir.ui.view">
            <field name="name">project.project.inherit.edit_project</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <field name="tag_ids" position="after">
                    <field name="excluded_company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="use_published_date"/>
                </field>
                <!-- Replace the single Company widget with multi-select. Keep
                     company_id in the arch (hidden) for core compute/inverse. -->
                <xpath expr="//field[@name='company_id']" position="replace">
                    <field name="company_ids"
                           string="Company"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           groups="base.group_multi_company"/>
                    <field name="company_id" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
