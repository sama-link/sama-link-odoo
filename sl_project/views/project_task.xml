<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sl_project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="allowed_assignee_user_ids" invisible="1"/>
                <field name="project_company_ids" invisible="1"/>
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assignee_user_ids), '|', ('company_id', 'in', project_company_ids), ('company_id', '=', company_id), ('share', '=', False), ('active', '=', True)]</attribute>
            </field>
            <!-- Place on its own labeled row after the whole Deadline/recurrence block
                 (not inside the inline flex div, which would render it unlabeled). -->
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                <field name="project_has_published_date" invisible="1"/>
                <field name="published_date" invisible="not project_has_published_date"/>
            </xpath>
        </field>
    </record>

    <record id="quick_create_task_form" model="ir.ui.view">
        <field name="name">project.task.quick.create.form.inherit.sl_project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="allowed_assignee_user_ids" invisible="1"/>
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assignee_user_ids), ('company_id', '=', company_id), ('share', '=', False), ('active', '=', True)]</attribute>
            </field>
        </field>
    </record>

    <!-- To-dos are project.task records too: same assignment restriction. -->
    <record id="project_task_view_todo_form" model="ir.ui.view">
        <field name="name">project.task.view.todo.form.inherit.sl_project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_todo.project_task_view_todo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="allowed_assignee_user_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assignee_user_ids), ('share', '=', False), ('active', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_todo_tree" model="ir.ui.view">
        <field name="name">project.task.todo.list.inherit.sl_project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_todo.project_task_view_todo_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="allowed_assignee_user_ids" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assignee_user_ids), ('share', '=', False), ('active', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Same assignment restriction for inline editing in the tasks list. -->
    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.list.inherit.sl_project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="allowed_assignee_user_ids" column_invisible="True"/>
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assignee_user_ids), ('share', '=', False), ('active', '=', True)]</attribute>
            </field>
        </field>
    </record>
</odoo>